{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/batch_packet.schema.json",
  "title": "Hash-pinned capability-improvement batch packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "experiment_digest", "batch_id", "branch", "phase", "parent_pack_digest", "protocol_ids", "reveal_state", "eligibility_status", "transfer_access_policy_digest", "artifacts", "trial_terminality", "learning_ledger", "packet_digest"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_capability_batch_packet.v1"},
    "packet_id": {"$ref": "#/$defs/id"},
    "experiment_digest": {"$ref": "#/$defs/sha256"},
    "batch_id": {"type": "string", "enum": ["B1", "B2", "B3", "B4", "B5"]},
    "branch": {"const": "cumulative"},
    "phase": {"type": "string", "enum": ["retrospective", "prospective"]},
    "parent_pack_digest": {"$ref": "#/$defs/sha256"},
    "protocol_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "reveal_state": {"type": "string", "enum": ["concealed", "revealed"]},
    "eligibility_status": {"const": "eligible_for_improvement"},
    "transfer_access_policy_digest": {"$ref": "#/$defs/sha256"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "trial_terminality": {"type": "array", "items": {"$ref": "#/$defs/terminal"}},
    "learning_ledger": {"oneOf": [{"$ref": "#/$defs/learning_ledger"}, {"type": "null"}]},
    "packet_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["protocol_id", "role", "path", "sha256", "visibility"], "properties": {"protocol_id": {"$ref": "#/$defs/id"}, "role": {"type": "string", "enum": ["target_source", "trial_result", "prediction", "trajectory", "verifier_reward", "verifier_details", "verifier_error_analysis", "c0_verifier_reward", "c0_verifier_error_analysis", "approved_groundtruth", "discrepancy_ledger"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "visibility": {"type": "string", "enum": ["agent_after_reveal", "orchestrator_only"]}}},
    "terminal": {"type": "object", "additionalProperties": false, "required": ["protocol_id", "branch", "status", "attempt_count", "frozen_output_sha256"], "properties": {"protocol_id": {"$ref": "#/$defs/id"}, "branch": {"type": "string", "enum": ["C0", "cumulative"]}, "status": {"type": "string", "enum": ["completed", "infrastructure_failed", "agent_failed", "timed_out", "invalid_output"]}, "attempt_count": {"type": "integer", "minimum": 1, "maximum": 3}, "frozen_output_sha256": {"$ref": "#/$defs/sha256"}}},
    "metric_effect": {"type": "object", "additionalProperties": false, "required": ["metric", "active_score", "c0_score", "paired_delta", "status"], "properties": {"metric": {"type": "string", "minLength": 1}, "active_score": {"type": ["number", "null"]}, "c0_score": {"type": ["number", "null"]}, "paired_delta": {"type": ["number", "null"]}, "status": {"type": "string", "enum": ["active_only_delta_unavailable", "paired"]}}},
    "learning_evidence": {"type": "object", "additionalProperties": false, "required": ["protocol_id", "artifact_sha256", "json_pointer", "support", "recoverability", "affected_metrics", "active_reward_sha256", "c0_reward_sha256", "metric_effects", "c0_matching_observation_count"], "properties": {"protocol_id": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "json_pointer": {"type": "string", "pattern": "^/"}, "support": {"type": "string", "minLength": 1}, "recoverability": {"type": "string", "minLength": 1}, "affected_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "active_reward_sha256": {"$ref": "#/$defs/sha256"}, "c0_reward_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "metric_effects": {"type": "array", "items": {"$ref": "#/$defs/metric_effect"}}, "c0_matching_observation_count": {"type": "integer", "minimum": 0}}},
    "learning_cluster": {"type": "object", "additionalProperties": false, "required": ["cluster_id", "task", "category", "entity_type", "process_cause", "finding_codes", "affected_metrics", "support_statuses", "recoverability_statuses", "observation_count", "protocol_count", "protocol_ids", "root_error_status", "evidence_refs", "metric_effects", "c0_observation_count"], "properties": {"cluster_id": {"type": "string", "pattern": "^cluster_[a-f0-9]{24}$"}, "task": {"type": "string", "minLength": 1}, "category": {"type": "string", "minLength": 1}, "entity_type": {"type": "string", "minLength": 1}, "process_cause": {"type": "string", "minLength": 1}, "finding_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "affected_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "support_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "recoverability_statuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "observation_count": {"type": "integer", "minimum": 1}, "protocol_count": {"type": "integer", "minimum": 1}, "protocol_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "root_error_status": {"type": "string", "enum": ["singleton", "recurring_across_protocols"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/learning_evidence"}}, "metric_effects": {"type": "array", "items": {"$ref": "#/$defs/metric_effect"}}, "c0_observation_count": {"type": "integer", "minimum": 0}}},
    "learning_filter_summary": {"type": "object", "additionalProperties": false, "required": ["substantive_observation_count", "admitted_observation_count", "excluded_observation_count", "admitted_root_event_count", "collapsed_observation_count", "excluded_by_reason"], "properties": {"substantive_observation_count": {"type": "integer", "minimum": 0}, "admitted_observation_count": {"type": "integer", "minimum": 0}, "excluded_observation_count": {"type": "integer", "minimum": 0}, "admitted_root_event_count": {"type": "integer", "minimum": 0}, "collapsed_observation_count": {"type": "integer", "minimum": 0}, "excluded_by_reason": {"type": "object", "additionalProperties": false, "required": ["infrastructure", "evaluator_defect", "policy_defect", "ground_truth_defect"], "properties": {"infrastructure": {"type": "integer", "minimum": 0}, "evaluator_defect": {"type": "integer", "minimum": 0}, "policy_defect": {"type": "integer", "minimum": 0}, "ground_truth_defect": {"type": "integer", "minimum": 0}}}}},
    "learning_ledger": {"type": "object", "additionalProperties": false, "required": ["schema_version", "batch_id", "protocol_ids", "source_artifacts", "filter_summary", "clusters", "ledger_digest"], "properties": {"schema_version": {"const": "libstruct.libgen_capability_learning_ledger.v1"}, "batch_id": {"type": "string", "enum": ["B1", "B2", "B3", "B4", "B5"]}, "protocol_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "source_artifacts": {"type": "array", "minItems": 10, "maxItems": 20, "items": {"type": "object", "additionalProperties": false, "required": ["protocol_id", "role", "artifact_sha256"], "properties": {"protocol_id": {"$ref": "#/$defs/id"}, "role": {"type": "string", "enum": ["verifier_error_analysis", "verifier_reward", "c0_verifier_error_analysis", "c0_verifier_reward"]}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}}}, "filter_summary": {"$ref": "#/$defs/learning_filter_summary"}, "clusters": {"type": "array", "items": {"$ref": "#/$defs/learning_cluster"}}, "ledger_digest": {"$ref": "#/$defs/sha256"}}}
  }
}

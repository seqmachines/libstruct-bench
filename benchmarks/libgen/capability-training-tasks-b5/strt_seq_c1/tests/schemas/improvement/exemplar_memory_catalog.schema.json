{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/exemplar_memory_catalog.schema.json",
  "title": "Pseudonymous exemplar-memory catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity_map_commitment",
    "exemplar_count",
    "exemplars",
    "catalog_digest"
  ],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_exemplar_memory.v1"},
    "identity_map_commitment": {"$ref": "#/$defs/sha256"},
    "exemplar_count": {"type": "integer", "enum": [0, 5, 10, 15, 20, 25]},
    "exemplars": {
      "type": "array",
      "maxItems": 25,
      "items": {"$ref": "#/$defs/catalog_item"}
    },
    "catalog_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "exemplar_id": {"type": "string", "pattern": "^exm-[a-f0-9]{32}$"},
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^exemplars/exm-[a-f0-9]{32}/(?:mechanism_summary|t2_example|t3_example)\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "catalog_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exemplar_id",
        "mechanism_summary",
        "t2_example",
        "t3_example",
        "exemplar_digest"
      ],
      "properties": {
        "exemplar_id": {"$ref": "#/$defs/exemplar_id"},
        "mechanism_summary": {"$ref": "#/$defs/file_ref"},
        "t2_example": {"$ref": "#/$defs/file_ref"},
        "t3_example": {"$ref": "#/$defs/file_ref"},
        "exemplar_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

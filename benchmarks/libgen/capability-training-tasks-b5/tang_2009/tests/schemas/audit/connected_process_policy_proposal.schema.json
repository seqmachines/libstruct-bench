{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/connected_process_policy_proposal.schema.json",
  "title": "Libgen connected-process representation proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "created_at",
    "status",
    "current_contract",
    "proposed_contract",
    "benchmark_inventory",
    "scoring_semantics",
    "human_decisions_required",
    "application_gate"
  ],
  "properties": {
    "proposal_id": {"$ref": "#/$defs/stable_id"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["unapproved", "accepted", "rejected"]},
    "current_contract": {"type": "object"},
    "proposed_contract": {"type": "object"},
    "benchmark_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_count",
        "current_workflow_count",
        "current_terminal_output_count",
        "proposed_workflow_count",
        "proposed_terminal_output_count",
        "workflow_merges",
        "in_place_graph_connection",
        "terminal_annotation_only"
      ],
      "properties": {
        "protocol_count": {"type": "integer", "minimum": 1},
        "current_workflow_count": {"type": "integer", "minimum": 1},
        "current_terminal_output_count": {"type": "integer", "minimum": 1},
        "proposed_workflow_count": {"type": "integer", "minimum": 1},
        "proposed_terminal_output_count": {"type": "integer", "minimum": 1},
        "workflow_merges": {"$ref": "#/$defs/id_array"},
        "in_place_graph_connection": {"$ref": "#/$defs/id_array"},
        "terminal_annotation_only": {"$ref": "#/$defs/id_array"}
      }
    },
    "scoring_semantics": {"type": "object"},
    "human_decisions_required": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "application_gate": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stable_id"}
    }
  }
}

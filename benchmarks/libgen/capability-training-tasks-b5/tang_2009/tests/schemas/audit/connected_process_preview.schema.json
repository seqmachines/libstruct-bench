{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/connected_process_preview.schema.json",
  "title": "Validated connected-process ground-truth preview manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preview_id",
    "migration_id",
    "created_at",
    "status",
    "benchmark_version_from",
    "benchmark_version_to",
    "plan_sha256",
    "policy_proposal_sha256",
    "policy_decision_sha256",
    "expected_structure",
    "observed_structure",
    "protocols",
    "canonical_ground_truth_modified"
  ],
  "properties": {
    "preview_id": {"$ref": "#/$defs/stable_id"},
    "migration_id": {"$ref": "#/$defs/stable_id"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "preview_only"},
    "benchmark_version_from": {"const": "2.0.0"},
    "benchmark_version_to": {"const": "3.0.0"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "policy_proposal_sha256": {"$ref": "#/$defs/sha256"},
    "policy_decision_sha256": {"$ref": "#/$defs/sha256"},
    "expected_structure": {"$ref": "#/$defs/counts"},
    "observed_structure": {"$ref": "#/$defs/counts"},
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protocol"}
    },
    "canonical_ground_truth_modified": {"const": false}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocols", "workflows", "terminal_outputs"],
      "properties": {
        "protocols": {"type": "integer", "minimum": 1},
        "workflows": {"type": "integer", "minimum": 1},
        "terminal_outputs": {"type": "integer", "minimum": 1}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "baseline_sha256", "candidate_sha256"],
      "properties": {
        "filename": {"type": "string", "minLength": 1},
        "baseline_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "artifacts",
        "workflow_count",
        "terminal_output_count",
        "linked_validation",
        "review_gate"
      ],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/artifact"}
        },
        "workflow_count": {"type": "integer", "minimum": 1},
        "terminal_output_count": {"type": "integer", "minimum": 1},
        "linked_validation": {"const": "passed"},
        "review_gate": {"type": "string", "enum": ["policy", "protocol"]},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "decision_sha256": {"$ref": "#/$defs/sha256"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"review_gate": {"const": "protocol"}},
            "required": ["review_gate"]
          },
          "then": {"required": ["proposal_sha256", "decision_sha256"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["proposal_sha256"]},
                {"required": ["decision_sha256"]}
              ]
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/validation_result_bundle.schema.json",
  "title": "Deterministic fixed-validation Harbor attempt bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "n_total_trials",
    "attempt_count",
    "canonical_config_sha256",
    "attempts",
    "selections",
    "created_at",
    "bundle_digest"
  ],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_validation_result_bundle.v1"},
    "n_total_trials": {"const": 5},
    "attempt_count": {"type": "integer", "minimum": 1},
    "canonical_config_sha256": {"$ref": "#/$defs/sha256"},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/attempt"}
    },
    "selections": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/selection"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "bundle_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol": {
      "type": "string",
      "enum": [
        "sci_atac_seq",
        "scrrbs",
        "smart_seq",
        "share_seq",
        "ddseq_single_cell_3_rna_seq_kit"
      ]
    },
    "protocols": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/protocol"}
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "config_sha256",
        "job_result_sha256",
        "planned_protocol_ids",
        "successful_protocol_ids",
        "unsuccessful_protocol_ids",
        "agent_timeout_multiplier",
        "job_concurrency"
      ],
      "properties": {
        "attempt_id": {"$ref": "#/$defs/id"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "job_result_sha256": {"$ref": "#/$defs/sha256"},
        "planned_protocol_ids": {"$ref": "#/$defs/protocols"},
        "successful_protocol_ids": {"$ref": "#/$defs/protocols"},
        "unsuccessful_protocol_ids": {"$ref": "#/$defs/protocols"},
        "agent_timeout_multiplier": {"type": "number", "minimum": 1},
        "job_concurrency": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "attempt_id",
        "source_trial_result_sha256",
        "source_exemplar_usage_sha256",
        "source_target_evidence_guard_sha256"
      ],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/protocol"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "source_trial_result_sha256": {"$ref": "#/$defs/sha256"},
        "source_exemplar_usage_sha256": {"$ref": "#/$defs/sha256"},
        "source_target_evidence_guard_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

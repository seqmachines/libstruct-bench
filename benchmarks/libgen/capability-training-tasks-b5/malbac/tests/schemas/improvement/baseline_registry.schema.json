{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/baseline_registry.schema.json",
  "title": "Hash-pinned no-capability-pack baseline registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "panel_id",
    "panel_commitment_sha256",
    "created_at",
    "tasks_root",
    "frozen_task_checksums",
    "matching_policy",
    "sources",
    "trial_records",
    "coverage",
    "agent_visibility",
    "registry_digest"
  ],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_baseline_registry.v1"},
    "registry_id": {"$ref": "#/$defs/id"},
    "panel_id": {"const": "frozen-retrospective-transfer-panel-v1"},
    "panel_commitment_sha256": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "format": "date-time"},
    "tasks_root": {"type": "string", "minLength": 1},
    "frozen_task_checksums": {
      "type": "object",
      "minProperties": 10,
      "maxProperties": 10,
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "matching_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_fields", "validity", "selection"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "validity": {"const": "complete_predictions_complete_required_metrics_no_exception_no_capability_pack"},
        "selection": {"const": "first_valid_source_by_declared_priority_per_semantic_configuration_and_protocol"}
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "trial_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/trial"}
    },
    "coverage": {
      "type": "array",
      "items": {"$ref": "#/$defs/coverage"}
    },
    "agent_visibility": {"const": "none_orchestrator_only"},
    "registry_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "sha256"],
      "properties": {
        "role": {"type": "string"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reward",
        "t2_exact_required_family_recall",
        "t2_required_family_f1",
        "t3_molecular_transition_f1",
        "t3_state_f1",
        "t3_typed_edge_f1"
      ],
      "properties": {
        "reward": {"type": ["number", "null"]},
        "t2_exact_required_family_recall": {"type": ["number", "null"]},
        "t2_required_family_f1": {"type": ["number", "null"]},
        "t3_molecular_transition_f1": {"type": ["number", "null"]},
        "t3_state_f1": {"type": ["number", "null"]},
        "t3_typed_edge_f1": {"type": ["number", "null"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "priority",
        "job_root",
        "config_sha256",
        "lock_sha256",
        "result_sha256",
        "semantic_configuration",
        "semantic_configuration_digest",
        "no_capability_pack"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "priority": {"type": "integer", "minimum": 1},
        "job_root": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "lock_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "semantic_configuration": {"type": "object"},
        "semantic_configuration_digest": {"$ref": "#/$defs/sha256"},
        "no_capability_pack": {"type": "boolean"}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "protocol_id",
        "trial_name",
        "semantic_configuration_digest",
        "task_checksum",
        "result_sha256",
        "artifact_hashes",
        "metrics",
        "status",
        "reason",
        "selected_for_reuse"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "protocol_id": {"$ref": "#/$defs/id"},
        "trial_name": {"$ref": "#/$defs/id"},
        "semantic_configuration_digest": {"$ref": "#/$defs/sha256"},
        "task_checksum": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_hashes": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        "metrics": {"$ref": "#/$defs/metrics"},
        "status": {"type": "string", "enum": ["valid_reusable", "invalid"]},
        "reason": {"type": "string", "minLength": 1},
        "selected_for_reuse": {"type": "boolean"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_configuration_digest",
        "agent",
        "model",
        "valid_selected_protocol_count",
        "missing_protocol_ids"
      ],
      "properties": {
        "semantic_configuration_digest": {"$ref": "#/$defs/sha256"},
        "agent": {"type": "string"},
        "model": {"type": "string"},
        "valid_selected_protocol_count": {"type": "integer", "minimum": 0, "maximum": 10},
        "missing_protocol_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}

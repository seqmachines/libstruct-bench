{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://seqmachines.org/schemas/libstruct/rendition_bundle.schema.json",
 "title": "Deterministic audit source rendition bundle",
 "type": "object",
 "additionalProperties": false,
 "required": ["bundle_id", "protocol_id", "input_manifest_sha256", "created_at", "toolchain", "sources"],
 "properties": {
 "bundle_id": {"$ref": "#/$defs/stable_id"},
 "protocol_id": {"$ref": "#/$defs/stable_id"},
 "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
 "created_at": {"type": "string", "format": "date-time"},
 "toolchain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}},
 "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
 },
 "$defs": {
 "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
 "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
 "tool": {
 "type": "object", "additionalProperties": false, "required": ["name", "version"],
 "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
 },
 "artifact": {
 "type": "object", "additionalProperties": false,
 "required": ["artifact_id", "kind", "path", "sha256", "size_bytes", "media_type"],
 "properties": {
 "artifact_id": {"$ref": "#/$defs/stable_id"},
 "kind": {"type": "string", "enum": ["native_text", "table_text", "page_image", "embedded_image"]},
 "path": {"type": "string", "minLength": 1},
 "sha256": {"$ref": "#/$defs/sha256"},
 "size_bytes": {"type": "integer", "minimum": 0},
 "media_type": {"type": "string", "minLength": 1},
 "page": {"type": "integer", "minimum": 1},
 "sheet": {"type": "string", "minLength": 1}
 }
 },
 "source": {
 "type": "object", "additionalProperties": false,
 "required": ["source_id", "source_sha256", "source_media_type", "status", "artifacts"],
 "properties": {
 "source_id": {"$ref": "#/$defs/stable_id"},
 "source_sha256": {"$ref": "#/$defs/sha256"},
 "source_media_type": {"type": "string", "minLength": 1},
 "status": {"const": "rendered"},
 "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
 "notes": {"type": ["string", "null"]}
 }
 }
 }
}

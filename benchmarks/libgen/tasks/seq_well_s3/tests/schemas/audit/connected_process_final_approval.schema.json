{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/connected_process_final_approval.schema.json",
  "title": "Final scientific approval for a connected-process preview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "migration_id",
    "approved_at",
    "status",
    "scientific_disposition",
    "reviewer",
    "preview_manifest",
    "source_check",
    "migration_plan",
    "policy_proposal",
    "preview_policy_decision",
    "approved_structure",
    "protocols",
    "application_authorized",
    "promotion_authorized",
    "canonical_ground_truth_modified",
    "scg_upload_modified",
    "notes"
  ],
  "properties": {
    "approval_id": {"$ref": "#/$defs/stable_id"},
    "migration_id": {"$ref": "#/$defs/stable_id"},
    "approved_at": {"type": "string", "format": "date-time"},
    "status": {"const": "final"},
    "scientific_disposition": {"const": "approved"},
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "preview_manifest": {"$ref": "#/$defs/artifact_ref"},
    "source_check": {"$ref": "#/$defs/artifact_ref"},
    "migration_plan": {"$ref": "#/$defs/artifact_ref"},
    "policy_proposal": {"$ref": "#/$defs/artifact_ref"},
    "preview_policy_decision": {"$ref": "#/$defs/artifact_ref"},
    "approved_structure": {"$ref": "#/$defs/counts"},
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protocol"}
    },
    "application_authorized": {"const": false},
    "promotion_authorized": {"const": false},
    "canonical_ground_truth_modified": {"const": false},
    "scg_upload_modified": {"const": false},
    "notes": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id"],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/stable_id"},
        "name": {"type": ["string", "null"]},
        "organization": {"type": ["string", "null"]}
      }
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocols", "workflows", "terminal_outputs"],
      "properties": {
        "protocols": {"type": "integer", "minimum": 1},
        "workflows": {"type": "integer", "minimum": 1},
        "terminal_outputs": {"type": "integer", "minimum": 1}
      }
    },
    "candidate_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "baseline_sha256", "candidate_sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "enum": [
            "groundtruth_final_lib_struct.json",
            "groundtruth_oligos.json",
            "groundtruth_library_generation_workflow.json"
          ]
        },
        "baseline_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "working_decision", "final_decision"],
      "properties": {
        "proposal": {"$ref": "#/$defs/artifact_ref"},
        "working_decision": {"$ref": "#/$defs/artifact_ref"},
        "final_decision": {"$ref": "#/$defs/artifact_ref"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "artifacts"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/candidate_artifact"}
        },
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}

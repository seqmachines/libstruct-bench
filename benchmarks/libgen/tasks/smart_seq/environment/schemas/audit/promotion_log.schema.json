{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/promotion_log.schema.json",
  "title": "Approved ground-truth promotion log",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "promotion_id", "protocol_id", "audit_id",
    "decision_id", "application_id", "proposal_sha256", "decision_sha256",
    "application_log_sha256", "created_at", "target_directory",
    "artifacts", "excluded_tasks"
  ],
  "properties": {
    "promotion_id": {"$ref": "#/$defs/stable_id"},
    "protocol_id": {"$ref": "#/$defs/stable_id"},
    "audit_id": {"$ref": "#/$defs/stable_id"},
    "decision_id": {"$ref": "#/$defs/stable_id"},
    "application_id": {"$ref": "#/$defs/stable_id"},
    "proposal_sha256": {"$ref": "#/$defs/sha256"},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "application_log_sha256": {"$ref": "#/$defs/sha256"},
    "regression_results_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "target_directory": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "excluded_tasks": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "enum": ["T1", "T2", "T3"]}
    }
  },
  "$defs": {
    "stable_id": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "source_id", "filename", "sha256"],
      "properties": {
        "task": {"type": "string", "enum": ["T1", "T2", "T3"]},
        "source_id": {"$ref": "#/$defs/stable_id"},
        "filename": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

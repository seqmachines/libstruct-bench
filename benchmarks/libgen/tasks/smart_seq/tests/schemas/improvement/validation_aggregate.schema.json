{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/validation_aggregate.schema.json",
  "title": "Sanitized fixed-validation macro aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_digest",
    "checkpoint_label",
    "checkpoint_digest",
    "checkpoint_sha256",
    "pack_digest",
    "pack_manifest_sha256",
    "runtime_digest",
    "runtime_sha256",
    "integration_digest",
    "integration_manifest_sha256",
    "task_bundle_sha256",
    "harbor_config_sha256",
    "result_bundle_digest",
    "diagnostic_bundle_digest",
    "result_file_count",
    "validation_panel_commitment_sha256",
    "access_policy_digest",
    "planned_trials",
    "scored_trials",
    "unscored_trials",
    "metric_counts",
    "macro_means",
    "feedback_scope",
    "guidance_target_batch",
    "created_at",
    "aggregate_digest"
  ],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_validation_aggregate.v1"},
    "experiment_digest": {"$ref": "#/$defs/sha256"},
    "checkpoint_label": {"$ref": "#/$defs/checkpoint"},
    "checkpoint_digest": {"$ref": "#/$defs/sha256"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "pack_digest": {"$ref": "#/$defs/sha256"},
    "pack_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_digest": {"$ref": "#/$defs/sha256"},
    "runtime_sha256": {"$ref": "#/$defs/sha256"},
    "integration_digest": {"$ref": "#/$defs/sha256"},
    "integration_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "task_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "harbor_config_sha256": {"$ref": "#/$defs/sha256"},
    "result_bundle_digest": {"$ref": "#/$defs/sha256"},
    "diagnostic_bundle_digest": {"$ref": "#/$defs/sha256"},
    "result_file_count": {"const": 6},
    "validation_panel_commitment_sha256": {"$ref": "#/$defs/sha256"},
    "access_policy_digest": {"$ref": "#/$defs/sha256"},
    "planned_trials": {"const": 5},
    "scored_trials": {"const": 5},
    "unscored_trials": {"const": 0},
    "metric_counts": {"$ref": "#/$defs/counts"},
    "macro_means": {"$ref": "#/$defs/metrics"},
    "feedback_scope": {"const": "five_protocol_macro_aggregate_only_no_example_memory"},
    "guidance_target_batch": {"type": ["string", "null"], "enum": ["B1", "B2", "B3", "B4", "B5", null]},
    "created_at": {"type": "string", "format": "date-time"},
    "aggregate_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "checkpoint": {"type": "string", "enum": ["C0", "C5", "C10", "C15", "C20", "C25"]},
    "score": {"type": "number", "minimum": 0, "maximum": 1},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reward", "t2_exact_required_family_recall", "t2_required_family_f1", "t3_molecular_transition_f1", "t3_state_f1", "t3_typed_edge_f1"],
      "properties": {
        "reward": {"const": 5},
        "t2_exact_required_family_recall": {"const": 5},
        "t2_required_family_f1": {"const": 5},
        "t3_molecular_transition_f1": {"const": 5},
        "t3_state_f1": {"const": 5},
        "t3_typed_edge_f1": {"const": 5}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reward", "t2_exact_required_family_recall", "t2_required_family_f1", "t3_molecular_transition_f1", "t3_state_f1", "t3_typed_edge_f1"],
      "properties": {
        "reward": {"$ref": "#/$defs/score"},
        "t2_exact_required_family_recall": {"$ref": "#/$defs/score"},
        "t2_required_family_f1": {"$ref": "#/$defs/score"},
        "t3_molecular_transition_f1": {"$ref": "#/$defs/score"},
        "t3_state_f1": {"$ref": "#/$defs/score"},
        "t3_typed_edge_f1": {"$ref": "#/$defs/score"}
      }
    }
  }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://seqmachines.org/schemas/libstruct/oligo_output_build.schema.json",
 "title": "Deterministic audited oligo-output build metadata",
 "type": "object",
 "additionalProperties": false,
 "required": ["created_at", "inputs", "catalog", "tsv"],
 "properties": {
 "created_at": {"type": "string", "format": "date-time"},
 "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
 "catalog": {"$ref": "#/$defs/output"},
 "tsv": {"$ref": "#/$defs/output"}
 },
 "$defs": {
 "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
 "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
 "input": {
 "type": "object",
 "additionalProperties": false,
 "required": ["protocol_id", "path", "sha256", "decision_ids"],
 "properties": {
 "protocol_id": {"$ref": "#/$defs/stable_id"},
 "path": {"type": "string", "minLength": 1},
 "sha256": {"$ref": "#/$defs/sha256"},
 "decision_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}
 }
 },
 "output": {
 "type": "object",
 "additionalProperties": false,
 "required": ["path", "sha256"],
 "properties": {
 "path": {"type": "string", "minLength": 1},
 "sha256": {"$ref": "#/$defs/sha256"}
 }
 }
 }
}

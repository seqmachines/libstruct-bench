{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/capability_work_record.schema.json",
  "title": "Model-neutral LibGen capability work record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "source_coverage",
    "inventory",
    "claims",
    "state_signatures",
    "event_records",
    "drafts"
  ],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_capability_work_record.v1"},
    "protocol_id": {"$ref": "#/$defs/id"},
    "source_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source_coverage"}
    },
    "inventory": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/inventory"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "state_signatures": {
      "type": "array",
      "items": {"$ref": "#/$defs/state_signature"}
    },
    "event_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/event_record"}
    },
    "drafts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t2", "t3"],
      "properties": {
        "t2": {
          "type": "object",
          "required": ["protocol_id", "oligos"]
        },
        "t3": {
          "type": "object",
          "required": ["protocol_id", "workflows"]
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "json_pointer"],
      "properties": {
        "target": {"type": "string", "enum": ["t2", "t3"]},
        "json_pointer": {"type": "string", "pattern": "^/"}
      }
    },
    "source_locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "source_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "artifact", "coverage_status", "locators", "notes"],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "artifact": {"type": "string", "minLength": 1},
        "coverage_status": {
          "type": "string",
          "enum": ["inspected", "partially_inspected", "unavailable"]
        },
        "locators": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_id",
        "item_kind",
        "name",
        "support",
        "derivation",
        "source_locators",
        "usage_scope",
        "disposition",
        "disposition_reason",
        "target_pointers"
      ],
      "properties": {
        "inventory_id": {"$ref": "#/$defs/id"},
        "item_kind": {
          "type": "string",
          "enum": ["oligo", "molecular_event", "molecular_state", "branch", "terminal"]
        },
        "name": {"type": "string", "minLength": 1},
        "support": {
          "type": "string",
          "enum": ["explicit", "derivable", "ambiguous", "unsupported"]
        },
        "derivation": {"type": ["string", "null"], "minLength": 1},
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_locator"}
        },
        "usage_scope": {
          "type": "string",
          "enum": [
            "physical_library_generation",
            "sequencing_only",
            "control_only",
            "procedural_only",
            "unknown"
          ]
        },
        "disposition": {
          "type": "string",
          "enum": ["modeled", "merged", "folded", "excluded", "unresolved"]
        },
        "disposition_reason": {"type": "string", "minLength": 1},
        "target_pointers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pointer"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"support": {"const": "derivable"}}, "required": ["support"]},
          "then": {"properties": {"derivation": {"type": "string", "minLength": 1}}}
        },
        {
          "if": {
            "properties": {"disposition": {"enum": ["modeled", "merged", "folded"]}},
            "required": ["disposition"]
          },
          "then": {"properties": {"target_pointers": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {"disposition": {"enum": ["excluded", "unresolved"]}},
            "required": ["disposition"]
          },
          "then": {"properties": {"target_pointers": {"maxItems": 0}}}
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "target",
        "json_pointer",
        "support",
        "source_locators"
      ],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "target": {"type": "string", "enum": ["t2", "t3"]},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "support": {
          "type": "string",
          "enum": ["explicit", "derivable", "ambiguous", "unsupported"]
        },
        "derivation": {"type": "string", "minLength": 1},
        "source_locators": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"support": {"const": "derivable"}}, "required": ["support"]},
          "then": {"required": ["derivation"]}
        }
      ]
    },
    "strand_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strand_id", "molecule_type", "segment_ids"],
      "properties": {
        "strand_id": {"$ref": "#/$defs/id"},
        "molecule_type": {"type": "string", "minLength": 1},
        "segment_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "state_signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "state_id",
        "inventory_ids",
        "strand_architecture",
        "reference_strand_id",
        "strands",
        "paired_region_ids",
        "discontinuity_ids"
      ],
      "properties": {
        "workflow_id": {"$ref": "#/$defs/id"},
        "state_id": {"$ref": "#/$defs/id"},
        "inventory_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "strand_architecture": {"type": "string", "minLength": 1},
        "reference_strand_id": {"$ref": "#/$defs/id"},
        "strands": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/strand_signature"}
        },
        "paired_region_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "discontinuity_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "event_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_id",
        "transition_id",
        "inventory_ids",
        "operation",
        "substrate_state_ids",
        "product_state_ids",
        "carried_forward_product_ids",
        "discarded_product_ids",
        "oligo_ids"
      ],
      "properties": {
        "workflow_id": {"$ref": "#/$defs/id"},
        "transition_id": {"$ref": "#/$defs/id"},
        "inventory_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "operation": {"type": "string", "minLength": 1},
        "substrate_state_ids": {"$ref": "#/$defs/id_array"},
        "product_state_ids": {"$ref": "#/$defs/id_array"},
        "carried_forward_product_ids": {"$ref": "#/$defs/id_array"},
        "discarded_product_ids": {"$ref": "#/$defs/id_array"},
        "oligo_ids": {"$ref": "#/$defs/id_array"}
      }
    },
    "id_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/capability_proposal_draft.schema.json",
  "title": "Agent-authored LibGen capability proposal draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_units"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_capability_proposal_draft.v1"},
    "change_units": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/unit"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "path", "baseline_sha256", "candidate_sha256"],
      "properties": {
        "operation": {"type": "string", "enum": ["add", "replace", "remove"]},
        "path": {"$ref": "#/$defs/path"},
        "baseline_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "candidate_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "polarity", "path"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "polarity": {"type": "string", "enum": ["positive", "negative", "boundary"]},
        "path": {"$ref": "#/$defs/path"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id", "cluster_ids", "generalized_failure_pattern",
        "update_type", "admission_basis", "synthetic_regression_case_ids",
        "capability_class", "applicability", "exclusions", "finding_codes",
        "residual_judgment", "counterexample", "expected_invariant",
        "enforcement_paths", "fixtures", "instruction_only_rationale",
        "mutations", "leakage_attestation"
      ],
      "properties": {
        "change_id": {"$ref": "#/$defs/id"},
        "cluster_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "generalized_failure_pattern": {"type": "string", "minLength": 1},
        "update_type": {"const": "procedural_or_tool"},
        "admission_basis": {"type": "string", "enum": ["recurring_root_error", "general_invariant_with_synthetic_regression", "insufficient"]},
        "synthetic_regression_case_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "capability_class": {"type": "string", "enum": ["deterministic", "hybrid", "instruction_only"]},
        "applicability": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "finding_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "residual_judgment": {"type": ["string", "null"], "minLength": 1},
        "counterexample": {"type": "string", "minLength": 1},
        "expected_invariant": {"type": "string", "minLength": 1},
        "enforcement_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}},
        "instruction_only_rationale": {"type": ["string", "null"], "minLength": 1},
        "mutations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mutation"}},
        "leakage_attestation": {"const": true}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/capability_proposal.schema.json",
  "title": "Structured LibGen capability change proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "experiment_digest", "branch", "batch_id", "checkpoint_from", "packet_digest", "parent_pack_digest", "learning_ledger_digest", "validation_guidance", "protocol_ids", "proposer", "revision_round", "revision_of_proposal_digest", "revision_request_decision_digest", "change_units", "proposal_digest"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_capability_proposal.v1"},
    "proposal_id": {"$ref": "#/$defs/id"},
    "experiment_digest": {"$ref": "#/$defs/sha256"},
    "branch": {"const": "cumulative"},
    "batch_id": {"type": "string", "enum": ["B1", "B2", "B3", "B4", "B5"]},
    "checkpoint_from": {"type": "string", "enum": ["C0", "C5", "C10", "C15", "C20"]},
    "packet_digest": {"$ref": "#/$defs/sha256"},
    "parent_pack_digest": {"$ref": "#/$defs/sha256"},
    "learning_ledger_digest": {"$ref": "#/$defs/sha256"},
    "validation_guidance": {"$ref": "#/$defs/validation_guidance"},
    "protocol_ids": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "proposer": {"$ref": "#/$defs/agent"},
    "revision_round": {"type": "integer", "minimum": 0, "maximum": 1},
    "revision_of_proposal_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "revision_request_decision_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "change_units": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/unit"}},
    "proposal_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "agent": {"type": "object", "additionalProperties": false, "required": ["agent", "harness", "model", "version", "reasoning_effort", "transcript_sha256"], "properties": {"agent": {"const": "codex"}, "harness": {"const": "native"}, "model": {"const": "gpt-5.6-sol"}, "version": {"type": "string", "minLength": 1}, "reasoning_effort": {"const": "max"}, "transcript_sha256": {"$ref": "#/$defs/sha256"}}},
    "metric_effect": {"type": "object", "additionalProperties": false, "required": ["metric", "active_score", "c0_score", "paired_delta", "status"], "properties": {"metric": {"type": "string", "minLength": 1}, "active_score": {"type": ["number", "null"]}, "c0_score": {"type": ["number", "null"]}, "paired_delta": {"type": ["number", "null"]}, "status": {"type": "string", "enum": ["active_only_delta_unavailable", "paired"]}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["protocol_id", "artifact_sha256", "json_pointer", "support", "recoverability", "affected_metrics", "active_reward_sha256", "c0_reward_sha256", "metric_effects", "c0_matching_observation_count"], "properties": {"protocol_id": {"$ref": "#/$defs/id"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "json_pointer": {"type": "string", "pattern": "^/"}, "support": {"type": "string", "minLength": 1}, "recoverability": {"type": "string", "minLength": 1}, "affected_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "active_reward_sha256": {"$ref": "#/$defs/sha256"}, "c0_reward_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "metric_effects": {"type": "array", "items": {"$ref": "#/$defs/metric_effect"}}, "c0_matching_observation_count": {"type": "integer", "minimum": 0}}},
    "mutation": {"type": "object", "additionalProperties": false, "required": ["operation", "path", "baseline_sha256", "candidate_sha256"], "properties": {"operation": {"type": "string", "enum": ["add", "replace", "remove"]}, "path": {"$ref": "#/$defs/path"}, "baseline_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "candidate_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["case_id", "polarity", "path"], "properties": {"case_id": {"$ref": "#/$defs/id"}, "polarity": {"type": "string", "enum": ["positive", "negative", "boundary"]}, "path": {"$ref": "#/$defs/path"}}},
    "unit": {"type": "object", "additionalProperties": false, "required": ["change_id", "cluster_ids", "evidence_refs", "generalized_failure_pattern", "update_type", "admission_basis", "synthetic_regression_case_ids", "capability_class", "applicability", "exclusions", "finding_codes", "residual_judgment", "counterexample", "expected_invariant", "enforcement_paths", "fixtures", "instruction_only_rationale", "mutations", "leakage_attestation"], "properties": {"change_id": {"$ref": "#/$defs/id"}, "cluster_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "generalized_failure_pattern": {"type": "string", "minLength": 1}, "update_type": {"const": "procedural_or_tool"}, "admission_basis": {"type": "string", "enum": ["recurring_root_error", "general_invariant_with_synthetic_regression", "insufficient"]}, "synthetic_regression_case_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "capability_class": {"type": "string", "enum": ["deterministic", "hybrid", "instruction_only"]}, "applicability": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "exclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "finding_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "residual_judgment": {"type": ["string", "null"], "minLength": 1}, "counterexample": {"type": "string", "minLength": 1}, "expected_invariant": {"type": "string", "minLength": 1}, "enforcement_paths": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/path"}}, "fixtures": {"type": "array", "items": {"$ref": "#/$defs/fixture"}}, "instruction_only_rationale": {"type": ["string", "null"], "minLength": 1}, "mutations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mutation"}}, "leakage_attestation": {"const": true}}},
    "validation_guidance": {"type": "object", "additionalProperties": false, "required": ["checkpoint_label", "aggregate_digest", "aggregate_sha256", "workspace_digest", "workspace_manifest_sha256"], "properties": {"checkpoint_label": {"type": "string", "enum": ["C0", "C5", "C10", "C15", "C20"]}, "aggregate_digest": {"$ref": "#/$defs/sha256"}, "aggregate_sha256": {"$ref": "#/$defs/sha256"}, "workspace_digest": {"$ref": "#/$defs/sha256"}, "workspace_manifest_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}

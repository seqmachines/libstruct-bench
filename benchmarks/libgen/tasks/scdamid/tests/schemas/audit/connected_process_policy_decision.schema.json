{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/connected_process_policy_decision.schema.json",
  "title": "Human decision on the Libgen connected-process representation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "proposal_id",
    "proposal_sha256",
    "reviewer",
    "decided_at",
    "disposition",
    "accepted_contract",
    "accepted_benchmark_version",
    "accepted_rescore_policy",
    "final_scientific_approval",
    "application_authorized",
    "notes"
  ],
  "properties": {
    "decision_id": {"$ref": "#/$defs/stable_id"},
    "proposal_id": {"$ref": "#/$defs/stable_id"},
    "proposal_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id"],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/stable_id"},
        "name": {"type": ["string", "null"]},
        "organization": {"type": ["string", "null"]}
      }
    },
    "decided_at": {"type": "string", "format": "date-time"},
    "disposition": {"const": "accept"},
    "accepted_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_connected_process_per_workflow",
        "modality_labeled_final_outputs",
        "score_shared_ancestors_once"
      ],
      "properties": {
        "one_connected_process_per_workflow": {"const": true},
        "modality_labeled_final_outputs": {"const": true},
        "score_shared_ancestors_once": {"const": true}
      }
    },
    "accepted_benchmark_version": {"const": "3.0.0"},
    "accepted_rescore_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compatible_predictions", "incompatible_predictions"],
      "properties": {
        "compatible_predictions": {"const": "rescore_in_versioned_sidecars"},
        "incompatible_predictions": {"const": "rerun"}
      }
    },
    "final_scientific_approval": {"const": "pending"},
    "application_authorized": {"const": false},
    "notes": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

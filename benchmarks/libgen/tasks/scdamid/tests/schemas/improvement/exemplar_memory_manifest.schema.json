{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/exemplar_memory_manifest.schema.json",
  "title": "Frozen pseudonymous exemplar-memory tree manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_self_excluded",
    "catalog_path",
    "catalog_digest",
    "identity_map_commitment",
    "exemplar_count",
    "files",
    "memory_digest"
  ],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_exemplar_memory_manifest.v1"},
    "manifest_self_excluded": {"const": true},
    "catalog_path": {"const": "catalog.json"},
    "catalog_digest": {"$ref": "#/$defs/sha256"},
    "identity_map_commitment": {"$ref": "#/$defs/sha256"},
    "exemplar_count": {"type": "integer", "enum": [0, 5, 10, 15, 20, 25]},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "mode"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "mode": {"type": "string", "enum": ["0444", "0555"]}
        }
      }
    },
    "memory_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

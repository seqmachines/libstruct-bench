{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/human_protocol_review_proposal_draft.schema.json",
  "title": "Codex-authored human protocol review proposal draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "comparison_digest", "revision_round", "summary", "successful_self_correction", "root_findings", "no_change_rationale"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_human_protocol_review_proposal_draft.v1"},
    "protocol_id": {"$ref": "#/$defs/id"},
    "comparison_digest": {"$ref": "#/$defs/sha256"},
    "revision_round": {"type": "integer", "minimum": 0, "maximum": 1},
    "summary": {"type": "string", "minLength": 1},
    "successful_self_correction": {"type": "string", "enum": ["observed", "not_observed", "unclear"]},
    "root_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "no_change_rationale": {"type": ["string", "null"], "minLength": 1}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "locator", "summary"],
      "properties": {
        "artifact_path": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "observation_ids", "category", "benchmark_validity", "attribution", "process_cause", "process_evidence", "diagnosis", "generalized_failure_pattern", "proposed_remedy", "applicability", "exclusions", "suggested_capability_class"],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "observation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^err_[0-9]{4}$"}},
        "category": {"type": "string", "enum": ["missing_recoverable_information", "unsupported_completion", "strand_or_orientation_error", "molecular_state_or_assembly_error", "operation_error", "workflow_or_topology_error", "representation_or_schema_error", "other", "unresolved"]},
        "benchmark_validity": {"type": "string", "enum": ["valid", "source_scope_mismatch", "ground_truth_defect", "policy_ambiguity", "source_conflict", "evaluator_defect", "unresolved"]},
        "attribution": {"type": "string", "enum": ["agent", "benchmark", "mixed", "infrastructure", "unresolved"]},
        "process_cause": {"type": "string", "enum": ["evidence_not_retrieved", "extraction_failure", "evidence_retrieved_but_misinterpreted", "molecular_or_strand_reasoning_error", "graph_abstraction_error", "context_or_time_limitation", "output_bookkeeping_error", "unresolved"]},
        "process_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "diagnosis": {"type": "string", "minLength": 1},
        "generalized_failure_pattern": {"type": "string", "minLength": 1},
        "proposed_remedy": {"type": "string", "minLength": 1},
        "applicability": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exclusions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "suggested_capability_class": {"type": "string", "enum": ["deterministic", "hybrid", "instruction_only", "no_change"]}
      }
    }
  }
}

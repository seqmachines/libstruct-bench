{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/connected_process_migration_plan.schema.json",
  "title": "Pinned plan for compiling connected-process T3 previews",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "migration_id",
    "created_at",
    "status",
    "benchmark_version_from",
    "benchmark_version_to",
    "policy_proposal",
    "policy_decision",
    "expected_structure",
    "protocols",
    "canonical_ground_truth_write_authorized"
  ],
  "properties": {
    "migration_id": {"$ref": "#/$defs/stable_id"},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"const": "approved_for_preview"},
    "benchmark_version_from": {"const": "2.0.0"},
    "benchmark_version_to": {"const": "3.0.0"},
    "policy_proposal": {"$ref": "#/$defs/artifact_ref"},
    "policy_decision": {"$ref": "#/$defs/artifact_ref"},
    "expected_structure": {"$ref": "#/$defs/counts"},
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protocol"}
    },
    "canonical_ground_truth_write_authorized": {"const": false}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocols", "workflows", "terminal_outputs"],
      "properties": {
        "protocols": {"type": "integer", "minimum": 1},
        "workflows": {"type": "integer", "minimum": 1},
        "terminal_outputs": {"type": "integer", "minimum": 1}
      }
    },
    "baseline_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {
          "type": "string",
          "enum": [
            "groundtruth_final_lib_struct.json",
            "groundtruth_oligos.json",
            "groundtruth_library_generation_workflow.json"
          ]
        },
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "decision", "required_issue_id"],
      "properties": {
        "proposal": {"$ref": "#/$defs/artifact_ref"},
        "decision": {"$ref": "#/$defs/artifact_ref"},
        "required_issue_id": {"$ref": "#/$defs/stable_id"}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "baseline_artifacts"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "baseline_artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/baseline_artifact"}
        },
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}

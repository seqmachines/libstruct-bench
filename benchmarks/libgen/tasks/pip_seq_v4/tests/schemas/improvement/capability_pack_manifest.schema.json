{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/capability_pack_manifest.schema.json",
  "title": "Model-neutral LibGen capability pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_kind", "manifest_self_excluded", "editable_roots", "immutable_paths", "files", "pack_digest"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_capability_pack.v1"},
    "pack_kind": {"const": "model_neutral"},
    "manifest_self_excluded": {"const": true},
    "editable_roots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"},
      "allOf": [
        {"contains": {"const": "schemas"}}
      ]
    },
    "immutable_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/path"},
      "allOf": [
        {"contains": {"const": "adapters/codex.md"}}
      ]
    },
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "pack_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "mode"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "mode": {"type": "string", "pattern": "^0[0-7]{3}$"}
      }
    }
  }
}

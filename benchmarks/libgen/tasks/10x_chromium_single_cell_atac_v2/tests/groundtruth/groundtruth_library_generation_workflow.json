          ],
          "operation": "tagmentation",
          "operation_detail": "Bulk Tn5 tagging of permeabilized nuclei in Transposition Mix; the transposome tags but does not fragment, leaving nuclei intact and a 9-bp gap at each insertion site. Three end combinations are produced; only the s5/s7 combination is amplifiable. Transposition also yields s5/s5 and s7/s7 fragments that semi-suppressive PCR does not amplify; they are not carried forward.",
          "product_state_ids": [
            "st_tagmented_s5_s7"
          ],
          "substrate_state_ids": [
            "st_nuclear_gdna"
          ],
          "support_status": "explicit",
          "transition_id": "tr_bulk_tagmentation"
        },
        {
          "carried_forward_product_ids": [
            "st_barcoded_linear_amplification_product"
          ],
          "discarded_product_ids": [],
          "major_reagents": [
            {
              "name": "Barcoding Reagent Mix (DNA polymerase)",
              "role": "polymerase"
            },
            {
              "name": "Dynabeads MyOne Silane",
              "role": "post-GEM cleanup"
            },
            {
              "name": "SPRIselect",
              "role": "cleanup"
            }
          ],
          "oligo_ids": [
            "oligo_beads_oligo"
          ],
          "operation": "amplification",
          "operation_detail": "Gap fill-in at 72 C extends each strand across the 9-bp transposase footprint and copies the opposing adapter, producing a blunt duplex; single-primer linear amplification from the gel-bead oligo then generates barcoded single-stranded DNA. Single-primer linear amplification inside the GEM: the released gel-bead oligo primes through its 3' s5 sequence and copies the fragment, adding P5 and the 16 nt 10x cell barcode. GEM breaking, Dynabead/Silane cleanup and SPRIselect removal of unused barcodes are folded in because they do not change sequence architecture.",
          "product_state_ids": [
            "st_barcoded_linear_amplification_product"
          ],
          "substrate_state_ids": [
            "st_tagmented_s5_s7"
          ],
          "support_status": "explicit",
          "transition_id": "tr_linear_amplification"
        },
        {

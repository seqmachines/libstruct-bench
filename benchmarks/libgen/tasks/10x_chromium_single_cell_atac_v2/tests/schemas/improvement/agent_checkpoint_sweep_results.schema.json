{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/agent_checkpoint_sweep_results.schema.json",
  "title": "Recorded macro results for one cumulative checkpoint sweep",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sweep_digest", "verifier_lock_digest", "rows", "created_at", "results_digest"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_agent_checkpoint_sweep_results.v1"},
    "sweep_digest": {"$ref": "#/$defs/sha256"},
    "verifier_lock_digest": {"$ref": "#/$defs/sha256"},
    "rows": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/row"}},
    "created_at": {"type": "string", "format": "date-time"},
    "results_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reward", "t2_exact_required_family_recall", "t2_required_family_f1", "t3_molecular_transition_f1", "t3_state_f1", "t3_typed_edge_f1"],
      "properties": {
        "reward": {"type": "number", "minimum": 0, "maximum": 1},
        "t2_exact_required_family_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "t2_required_family_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "t3_molecular_transition_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "t3_state_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "t3_typed_edge_f1": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_label", "pack_digest", "result_root", "result_bundle_digest", "macro_means", "delta_from_c0"],
      "properties": {
        "checkpoint_label": {"type": "string", "enum": ["C5", "C10", "C15", "C20", "C25"]},
        "pack_digest": {"$ref": "#/$defs/sha256"},
        "result_root": {"type": "string", "minLength": 1},
        "result_bundle_digest": {"$ref": "#/$defs/sha256"},
        "macro_means": {"$ref": "#/$defs/metrics"},
        "delta_from_c0": {"$ref": "#/$defs/deltas"}
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reward", "t2_exact_required_family_recall", "t2_required_family_f1", "t3_molecular_transition_f1", "t3_state_f1", "t3_typed_edge_f1"],
      "properties": {
        "reward": {"type": "number", "minimum": -1, "maximum": 1},
        "t2_exact_required_family_recall": {"type": "number", "minimum": -1, "maximum": 1},
        "t2_required_family_f1": {"type": "number", "minimum": -1, "maximum": 1},
        "t3_molecular_transition_f1": {"type": "number", "minimum": -1, "maximum": 1},
        "t3_state_f1": {"type": "number", "minimum": -1, "maximum": 1},
        "t3_typed_edge_f1": {"type": "number", "minimum": -1, "maximum": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/connected_process_source_check.schema.json",
  "title": "Direct primary-source check for connected-process T3 candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "check_id",
    "migration_id",
    "checked_at",
    "status",
    "checker",
    "preview_manifest",
    "protocols",
    "resolved_findings",
    "summary"
  ],
  "properties": {
    "check_id": {"$ref": "#/$defs/stable_id"},
    "migration_id": {"$ref": "#/$defs/stable_id"},
    "checked_at": {"type": "string", "format": "date-time"},
    "status": {"const": "complete"},
    "checker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checker_id", "role"],
      "properties": {
        "checker_id": {"$ref": "#/$defs/stable_id"},
        "role": {"const": "audit_controller"}
      }
    },
    "preview_manifest": {"$ref": "#/$defs/artifact_ref"},
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protocol_check"}
    },
    "resolved_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/resolved_finding"}
    },
    "summary": {"$ref": "#/$defs/summary"}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {"$ref": "#/$defs/stable_id"},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "record_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "record_id",
        "status",
        "source_refs",
        "notes"
      ],
      "properties": {
        "record_type": {"type": "string", "enum": ["state", "transition"]},
        "record_id": {"$ref": "#/$defs/stable_id"},
        "status": {
          "type": "string",
          "enum": ["verified", "conflict", "missing", "ambiguous"]
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_ref"}
        },
        "notes": {"type": "string", "minLength": 1},
        "resolution_finding_id": {"$ref": "#/$defs/stable_id"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "verified"}},
            "required": ["status"]
          },
          "then": {"not": {"required": ["resolution_finding_id"]}},
          "else": {"required": ["resolution_finding_id"]}
        }
      ]
    },
    "record_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions"],
      "properties": {
        "states": {"type": "integer", "minimum": 0},
        "transitions": {"type": "integer", "minimum": 0}
      }
    },
    "protocol_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_id",
        "packet_sha256",
        "candidate_t3_sha256",
        "counts",
        "records"
      ],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "packet_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_t3_sha256": {"$ref": "#/$defs/sha256"},
        "counts": {"$ref": "#/$defs/record_counts"},
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/record_check"}
        }
      }
    },
    "resolved_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "protocol_id",
        "observed_status",
        "disposition",
        "reviewer_id",
        "decided_at",
        "decision",
        "source_refs",
        "resolution"
      ],
      "properties": {
        "finding_id": {"$ref": "#/$defs/stable_id"},
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "observed_status": {
          "type": "string",
          "enum": ["conflict", "missing", "ambiguous"]
        },
        "disposition": {
          "type": "string",
          "enum": ["accept", "reject", "modify", "unresolved"]
        },
        "reviewer_id": {"$ref": "#/$defs/stable_id"},
        "decided_at": {"type": "string", "format": "date-time"},
        "decision": {"$ref": "#/$defs/artifact_ref"},
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_ref"}
        },
        "resolution": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocols",
        "states",
        "transitions",
        "verified",
        "conflict",
        "missing",
        "ambiguous",
        "unresolved"
      ],
      "properties": {
        "protocols": {"type": "integer", "minimum": 1},
        "states": {"type": "integer", "minimum": 0},
        "transitions": {"type": "integer", "minimum": 0},
        "verified": {"type": "integer", "minimum": 0},
        "conflict": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "ambiguous": {"type": "integer", "minimum": 0},
        "unresolved": {"type": "integer", "minimum": 0}
      }
    }
  }
}

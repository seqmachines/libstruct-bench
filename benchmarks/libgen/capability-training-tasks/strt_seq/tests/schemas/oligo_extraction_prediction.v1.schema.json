{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/oligo_extraction_prediction.v1.schema.json",
  "title": "libstruct oligo extraction prediction v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "protocol_id", "oligos"],
  "properties": {
    "schema_version": {
      "const": "libstruct.oligo_extraction.v1"
    },
    "protocol_id": {
      "type": "string",
      "minLength": 1
    },
    "oligos": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name"],
        "anyOf": [
          {
            "required": ["sequence"],
            "properties": {
              "sequence": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": ["components"]
          },
          {
            "required": ["strands"]
          }
        ],
        "properties": {
          "oligo_id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "sequence": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": ["single", "assembled", "double_stranded", "hairpin", "unknown"]
          },
          "direction": {
            "type": "string",
            "default": "unknown"
          },
          "components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/component"
            }
          },
          "strands": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/component"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sequence"],
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "sequence": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "default": "unknown"
        }
      }
    }
  }
}

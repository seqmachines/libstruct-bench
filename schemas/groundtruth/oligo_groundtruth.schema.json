{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/oligo_groundtruth.schema.json",
  "title": "Human-approved oligo ground truth",
  "description": "T2: minimal oligo identity and composition. Audit evidence and lineage remain in audit artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "protocol_name", "oligos"],
  "properties": {
    "protocol_id": {"$ref": "#/$defs/stable_id"},
    "protocol_name": {"type": "string", "minLength": 1},
    "protocol_scope": {"$ref": "#/$defs/protocol_scope"},
    "oligos": {"type": "array", "items": {"$ref": "#/$defs/oligo"}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "protocol_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "applicable_variants"],
      "properties": {
        "protocol_version": {"type": ["string", "null"], "minLength": 1},
        "applicable_variants": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "support_status": {"type": "string", "enum": ["explicit", "derivable", "externally_completed", "ambiguous", "unsupported"]},
    "placeholder": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\[(?![A-Z0-9_]*(?:_RC|_REVCOMP|_REVERSE_COMPLEMENT|_FWD|_FORWARD|_REV|_REVERSE)(?::[1-9][0-9]*)?\\]$)[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*(?::[1-9][0-9]*)?\\]$",
      "description": "Orientation-free [ROLE] or [ROLE:LENGTH] placeholder."
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ordered inline oligo component. Components are not independently identified or referenced.",
      "required": ["name", "role", "orientation", "modifications", "support_status"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "sequence": {"type": ["string", "null"], "minLength": 1},
        "length": {"type": ["integer", "null"], "minimum": 0},
        "placeholder": {"oneOf": [{"$ref": "#/$defs/placeholder"}, {"type": "null"}]},
        "orientation": {"type": "string", "enum": ["5_to_3", "3_to_5", "unknown"]},
        "modifications": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "protocol_scope": {"$ref": "#/$defs/protocol_scope"},
        "support_status": {"$ref": "#/$defs/support_status"}
      },
      "anyOf": [
        {"required": ["sequence"], "properties": {"sequence": {"type": "string", "minLength": 1}}},
        {"required": ["length"], "properties": {"length": {"type": "integer", "minimum": 0}}},
        {"required": ["placeholder"], "properties": {"placeholder": {"type": "string", "minLength": 1}}}
      ]
    },
    "oligo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oligo_id", "name", "aliases", "role", "kind", "orientation", "components", "modifications", "support_status"],
      "properties": {
        "oligo_id": {"$ref": "#/$defs/stable_id"},
        "canonical_oligo_id": {"oneOf": [{"$ref": "#/$defs/stable_id"}, {"type": "null"}]},
        "family_id": {"oneOf": [{"$ref": "#/$defs/stable_id"}, {"type": "null"}]},
        "name": {"type": "string", "minLength": 1, "description": "Canonical display name; use the source-visible name for assay-specific oligos."},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "role": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["single", "assembled", "double_stranded", "hairpin", "unknown"]},
        "sequence": {"type": ["string", "null"], "minLength": 1, "description": "Source-visible oligo sequence in the recorded orientation."},
        "orientation": {"type": "string", "enum": ["5_to_3", "3_to_5", "unknown"]},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}},
        "modifications": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "protocol_scope": {"$ref": "#/$defs/protocol_scope"},
        "support_status": {"$ref": "#/$defs/support_status"}
      },
      "anyOf": [
        {"required": ["sequence"], "properties": {"sequence": {"type": "string", "minLength": 1}}},
        {"required": ["components"], "properties": {"components": {"minItems": 1}}}
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/library_generation_workflow.v1.schema.json",
  "title": "Audited molecular library-generation workflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "protocol_name", "workflows"],
  "properties": {
    "schema_version": {"const": "libstruct.library_generation_workflow.v1"},
    "protocol_id": {"$ref": "#/$defs/stable_id"},
    "protocol_name": {"type": "string", "minLength": 1},
    "workflows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workflow"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator"], "properties": {"source_id": {"$ref": "#/$defs/stable_id"}, "locator": {"type": "object", "minProperties": 1}, "excerpt": {"type": ["string", "null"]}}},
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "order", "operation", "inputs", "reagent_refs", "oligo_refs", "outputs", "support_status", "evidence"],
      "properties": {"step_id": {"$ref": "#/$defs/stable_id"}, "order": {"type": "integer", "minimum": 1}, "operation": {"type": "string", "minLength": 1}, "inputs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "reagent_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "oligo_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "transformations": {"type": "array", "items": {"type": "string", "minLength": 1}}, "outputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "support_status": {"type": "string", "enum": ["explicit", "derivable", "externally_completed", "ambiguous", "unsupported"]}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "notes": {"type": ["string", "null"]}},
      "allOf": [{"if": {"properties": {"support_status": {"enum": ["explicit", "derivable", "externally_completed"]}}, "required": ["support_status"]}, "then": {"properties": {"evidence": {"minItems": 1}}}}]
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_id", "modality", "input_material", "benchmark_status", "steps", "final_library_refs"],
      "properties": {"workflow_id": {"$ref": "#/$defs/stable_id"}, "modality": {"type": "string", "minLength": 1}, "input_material": {"type": "string", "minLength": 1}, "benchmark_status": {"type": "string", "enum": ["included", "excluded"]}, "exclusion_reason": {"type": ["string", "null"], "minLength": 1}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "final_library_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "notes": {"type": ["string", "null"]}},
      "allOf": [{"if": {"properties": {"benchmark_status": {"const": "excluded"}}, "required": ["benchmark_status"]}, "then": {"required": ["exclusion_reason"]}}]
    }
  }
}

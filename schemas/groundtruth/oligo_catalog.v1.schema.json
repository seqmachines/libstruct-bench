{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/oligo_catalog.v1.schema.json",
  "title": "Reviewed cross-protocol canonical oligo catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "created_at", "oligos"],
  "properties": {
    "schema_version": {"const": "libstruct.oligo_catalog.v1"},
    "catalog_id": {"$ref": "#/$defs/stable_id"},
    "created_at": {"type": "string", "format": "date-time"},
    "oligos": {"type": "array", "items": {"$ref": "#/$defs/oligo"}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "oligo": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_oligo_id", "canonical_name", "aliases", "role", "sequence", "direction", "protocol_refs", "decision_ids"],
      "properties": {"canonical_oligo_id": {"$ref": "#/$defs/stable_id"}, "canonical_name": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "role": {"type": "string", "minLength": 1}, "sequence": {"type": "string", "minLength": 1}, "direction": {"type": "string", "enum": ["5_to_3", "3_to_5", "unknown"]}, "family_id": {"oneOf": [{"$ref": "#/$defs/stable_id"}, {"type": "null"}]}, "protocol_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "decision_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "notes": {"type": ["string", "null"]}}
    }
  }
}

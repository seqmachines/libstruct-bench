{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/final_library_groundtruth.v1.schema.json",
  "title": "Audited final-library ground truth v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "protocol_name", "libraries"],
  "properties": {
    "schema_version": {"const": "libstruct.final_library_groundtruth.v1"},
    "protocol_id": {"$ref": "#/$defs/stable_id"},
    "protocol_name": {"type": "string", "minLength": 1},
    "libraries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/library"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "locator"],
      "properties": {"source_id": {"$ref": "#/$defs/stable_id"}, "locator": {"type": "object", "minProperties": 1}, "excerpt": {"type": ["string", "null"]}}
    },
    "segment": {
      "type": "object", "additionalProperties": false,
      "required": ["segment_id", "kind", "role"],
      "properties": {
        "segment_id": {"$ref": "#/$defs/stable_id"}, "kind": {"type": "string", "enum": ["constant", "variable", "biological_insert"]}, "role": {"type": "string", "minLength": 1},
        "sequence": {"type": ["string", "null"]}, "length": {"type": ["integer", "null"], "minimum": 0}, "placeholder": {"type": ["string", "null"]},
        "oligo_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "strand": {
      "type": "object", "additionalProperties": false, "required": ["direction", "sequence"],
      "properties": {"direction": {"type": "string", "enum": ["5_to_3", "3_to_5", "unknown"]}, "sequence": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}}
    },
    "library": {
      "type": "object", "additionalProperties": false,
      "required": ["library_id", "modality", "library_sequence", "benchmark_status", "support_status", "evidence", "segments"],
      "properties": {
        "library_id": {"$ref": "#/$defs/stable_id"}, "modality": {"type": "string", "minLength": 1}, "final_molecule": {"type": ["string", "null"]},
        "library_sequence": {"type": "string", "minLength": 1}, "annotated_library_sequence": {"type": ["string", "null"]},
        "benchmark_status": {"type": "string", "enum": ["included", "excluded"]}, "exclusion_reason": {"type": ["string", "null"], "minLength": 1},
        "strands": {"type": "array", "items": {"$ref": "#/$defs/strand"}}, "segments": {"type": "array", "items": {"$ref": "#/$defs/segment"}},
        "support_status": {"type": "string", "enum": ["explicit", "derivable", "externally_completed", "ambiguous", "unsupported"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "notes": {"type": ["string", "null"]}
      },
      "allOf": [{"if": {"properties": {"benchmark_status": {"const": "excluded"}}, "required": ["benchmark_status"]}, "then": {"required": ["exclusion_reason"]}}]
    }
  }
}

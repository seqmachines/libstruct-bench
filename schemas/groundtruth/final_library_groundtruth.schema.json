{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/final_library_groundtruth.schema.json",
  "title": "Human-approved final-library ground truth",
  "description": "T1: minimal final sequencing-ready library structures. Audit evidence and decisions remain in audit artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_id", "protocol_name", "libraries"],
  "properties": {
    "protocol_id": {"$ref": "#/$defs/stable_id"},
    "protocol_name": {"type": "string", "minLength": 1},
    "protocol_scope": {"$ref": "#/$defs/protocol_scope"},
    "libraries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/library"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "protocol_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "applicable_variants"],
      "properties": {
        "protocol_version": {"type": ["string", "null"], "minLength": 1},
        "applicable_variants": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "support_status": {"type": "string", "enum": ["explicit", "derivable", "externally_completed", "ambiguous", "unsupported"]},
    "placeholder": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\[(?![A-Z0-9_]*(?:_RC|_REVCOMP|_REVERSE_COMPLEMENT|_FWD|_FORWARD|_REV|_REVERSE)(?::[1-9][0-9]*)?\\]$)[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*(?::[1-9][0-9]*)?\\]$",
      "description": "Orientation-free [ROLE] or [ROLE:LENGTH] placeholder. Include LENGTH when known for a fixed variable region."
    },
    "oligo_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oligo_id", "orientation_to_source"],
      "properties": {
        "oligo_id": {"$ref": "#/$defs/stable_id"},
        "orientation_to_source": {"type": "string", "enum": ["same_orientation", "reverse_complement", "unknown"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "kind", "role", "orientation", "support_status"],
      "properties": {
        "segment_id": {"$ref": "#/$defs/stable_id"},
        "kind": {"type": "string", "enum": ["constant", "variable", "biological_insert", "unknown"]},
        "role": {"type": "string", "minLength": 1},
        "sequence": {"type": ["string", "null"], "minLength": 1, "description": "Exact bases on the canonical T1 reference strand."},
        "length": {"type": ["integer", "null"], "minimum": 0},
        "placeholder": {"oneOf": [{"$ref": "#/$defs/placeholder"}, {"type": "null"}]},
        "orientation": {"type": "string", "enum": ["5_to_3", "3_to_5", "unknown"]},
        "oligo_derivations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/oligo_derivation"}},
        "protocol_scope": {"$ref": "#/$defs/protocol_scope"},
        "support_status": {"$ref": "#/$defs/support_status"},
        "notes": {"type": ["string", "null"]}
      },
      "anyOf": [
        {"required": ["sequence"], "properties": {"sequence": {"type": "string", "minLength": 1}}},
        {"required": ["length"], "properties": {"length": {"type": "integer", "minimum": 0}}},
        {"required": ["placeholder"], "properties": {"placeholder": {"type": "string", "minLength": 1}}}
      ]
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modality", "library_sequence", "annotated_library_sequence", "strand", "orientation", "support_status", "segments"],
      "properties": {
        "modality": {"type": "string", "minLength": 1},
        "protocol_scope": {"$ref": "#/$defs/protocol_scope"},
        "final_molecule": {"type": ["string", "null"], "minLength": 1},
        "library_sequence": {"type": "string", "minLength": 1},
        "annotated_library_sequence": {"type": "string", "minLength": 1},
        "strand": {"type": "string", "enum": ["top", "bottom", "single", "duplex", "unknown"]},
        "orientation": {"type": "string", "enum": ["5_to_3", "3_to_5", "unknown"]},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}},
        "support_status": {"$ref": "#/$defs/support_status"},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}

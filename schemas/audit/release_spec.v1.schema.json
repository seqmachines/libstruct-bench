{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/release_spec.v1.schema.json",
  "title": "Audited ground-truth release build specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "version", "release_status", "created_at", "expected_protocol_count", "reviewed_protocol_count", "generated_by", "source_datasets", "policy_paths", "schema_paths", "checkpoint_paths", "independent_audit", "protocols", "oligo_outputs"],
  "properties": {
    "schema_version": {"const": "libstruct.release_spec.v1"},
    "release_id": {"$ref": "#/$defs/stable_id"}, "version": {"type": "string", "minLength": 1}, "release_status": {"type": "string", "enum": ["candidate", "frozen"]}, "created_at": {"type": "string", "format": "date-time"},
    "expected_protocol_count": {"type": "integer", "minimum": 1}, "reviewed_protocol_count": {"type": "integer", "minimum": 0},
    "generated_by": {"type": "object", "additionalProperties": false, "required": ["tool_version", "git_commit"], "properties": {"tool_version": {"type": "string", "minLength": 1}, "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}},
    "source_datasets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["provider", "repository", "revision"], "properties": {"provider": {"type": "string", "enum": ["huggingface", "git"]}, "repository": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 7}}}},
    "policy_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}},
    "schema_paths": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "schema_version"], "properties": {"path": {"$ref": "#/$defs/path"}, "schema_version": {"type": "string", "minLength": 1}}}},
    "checkpoint_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}},
    "independent_audit": {"type": "object", "additionalProperties": false, "required": ["seed", "sample_fraction", "selected_protocol_ids"], "properties": {"seed": {"type": "string", "minLength": 1}, "sample_fraction": {"const": 0.1}, "selected_protocol_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}}},
    "protocols": {"type": "array", "items": {"$ref": "#/$defs/protocol"}},
    "oligo_outputs": {"type": "object", "additionalProperties": false, "required": ["catalog_path", "tsv_path", "build_metadata_path"], "properties": {"catalog_path": {"$ref": "#/$defs/path"}, "tsv_path": {"$ref": "#/$defs/path"}, "build_metadata_path": {"$ref": "#/$defs/path"}}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "task_dispositions": {"type": "object", "additionalProperties": false, "required": ["T1", "T2", "T3"], "properties": {"T1": {"type": "string", "enum": ["included", "excluded", "unresolved"]}, "T2": {"type": "string", "enum": ["included", "excluded", "unresolved"]}, "T3": {"type": "string", "enum": ["included", "excluded", "unresolved"]}}},
    "identified_path": {"type": "object", "additionalProperties": false, "required": ["id", "path"], "properties": {"id": {"$ref": "#/$defs/stable_id"}, "path": {"$ref": "#/$defs/path"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["task", "path", "schema_version", "artifact_source_id"], "properties": {"task": {"type": "string", "enum": ["T1", "T2", "T3", "oligo_catalog"]}, "path": {"$ref": "#/$defs/path"}, "schema_version": {"type": "string", "minLength": 1}, "artifact_source_id": {"$ref": "#/$defs/stable_id"}}},
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "task_dispositions", "input_manifest_path", "evidence", "audits", "decisions", "applications", "artifacts", "unresolved_issue_ids", "limitations"],
      "properties": {"protocol_id": {"$ref": "#/$defs/stable_id"}, "task_dispositions": {"$ref": "#/$defs/task_dispositions"}, "input_manifest_path": {"$ref": "#/$defs/path"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identified_path"}}, "audits": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identified_path"}}, "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identified_path"}}, "applications": {"type": "array", "items": {"$ref": "#/$defs/identified_path"}}, "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}, "unresolved_issue_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    }
  }
}

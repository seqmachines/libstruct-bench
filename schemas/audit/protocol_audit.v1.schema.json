{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/protocol_audit.v1.schema.json",
  "title": "Sequencing-library protocol audit proposal v1",
  "description": "Read-only agent findings and correction proposals for one protocol. This document is never a human approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_id",
    "protocol_id",
    "input_manifest_sha256",
    "baseline_artifacts",
    "run",
    "disposition",
    "summary",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "libstruct.protocol_audit.v1"
    },
    "audit_id": {
      "$ref": "#/$defs/stable_id"
    },
    "protocol_id": {
      "$ref": "#/$defs/stable_id"
    },
    "input_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "baseline_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact_hash"
      }
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "disposition": {
      "type": "string",
      "enum": [
        "confirmed",
        "changes_proposed",
        "ambiguous",
        "insufficient_evidence"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "confirmed"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "changes_proposed"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "issues": {
            "minItems": 1,
            "contains": {
              "type": "object",
              "required": [
                "recommendation"
              ],
              "properties": {
                "recommendation": {
                  "const": "propose_change"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent",
        "provider",
        "model",
        "tool_version",
        "review_mode",
        "started_at",
        "completed_at",
        "prompt_sha256",
        "skill_sha256",
        "schema_sha256"
      ],
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "review_mode": {
          "type": "string",
          "enum": [
            "primary",
            "independent"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "prompt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "skill_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "benchmark_record",
            "evaluator",
            "normalization_policy",
            "source_bundle"
          ]
        },
        "artifact_source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "library_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "modality": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "cell_range": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "figure": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "html_selector": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator",
        "supports"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "supports": {
          "type": "string",
          "enum": [
            "current",
            "proposed",
            "alternative",
            "context"
          ]
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_sequence": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "input",
        "output",
        "rationale"
      ],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "reverse_complement",
            "remove_direction_wrapper",
            "expand_homopolymer",
            "normalize_placeholder",
            "omit_biological_insert",
            "assemble_construct",
            "other"
          ]
        },
        "input": {
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "json_patch_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "add",
            "remove",
            "replace",
            "test"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "add",
                  "replace",
                  "test"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "remove"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "category",
        "title",
        "target",
        "assessment",
        "evidence",
        "transformations",
        "recommendation",
        "proposed_patch",
        "confidence"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/stable_id"
        },
        "category": {
          "type": "string",
          "enum": [
            "external_knowledge",
            "source_conflict",
            "schematic_final_product_conflict",
            "variable_region_length",
            "strand_orientation",
            "missing_final_library",
            "protocol_version_mismatch",
            "normalization_policy",
            "evaluator_assignment",
            "identifier_normalization",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "support",
            "rationale"
          ],
          "properties": {
            "support": {
              "type": "string",
              "enum": [
                "primary_explicit",
                "primary_derived",
                "legacy_only",
                "conflicting",
                "absent",
                "ambiguous"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "transformations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transformation"
          }
        },
        "recommendation": {
          "type": "string",
          "enum": [
            "keep_current",
            "propose_change",
            "add_source",
            "revise_policy",
            "fix_evaluator",
            "exclude_from_scoring",
            "needs_human_review"
          ]
        },
        "proposed_patch": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_patch_operation"
          }
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "recommendation": {
                "const": "propose_change"
              }
            },
            "required": [
              "recommendation"
            ]
          },
          "then": {
            "properties": {
              "proposed_patch": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "proposed_patch": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}

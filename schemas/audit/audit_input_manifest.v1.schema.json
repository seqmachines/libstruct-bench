{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/audit_input_manifest.v1.schema.json",
  "title": "Library-structure audit input manifest v1",
  "description": "Content-addressed inputs for one protocol audit. Primary evidence, legacy curated HTML, and current benchmark records are separate source roles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "protocol_id",
    "created_at",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "libstruct.audit_input_manifest.v1"
    },
    "manifest_id": {
      "$ref": "#/$defs/stable_id"
    },
    "protocol_id": {
      "$ref": "#/$defs/stable_id"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "properties": {
        "sources": {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "primary_evidence"
              }
            }
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "sources": {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "legacy_curated_html"
              }
            }
          },
          "minContains": 1
        }
      }
    },
    {
      "properties": {
        "sources": {
          "contains": {
            "type": "object",
            "required": [
              "role"
            ],
            "properties": {
              "role": {
                "const": "current_benchmark_record"
              }
            }
          },
          "minContains": 1
        }
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataset_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "path"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "role",
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "role": {
          "type": "string",
          "enum": [
            "primary_evidence",
            "legacy_curated_html",
            "current_benchmark_record"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Portable path within the private audit-data checkout or source dataset; never a machine-specific absolute path."
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "document_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_reference": {
          "oneOf": [
            {
              "$ref": "#/$defs/dataset_reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://seqmachines.org/schemas/libstruct/application_log.schema.json",
 "title": "Deterministic audit correction application log",
 "type": "object",
 "additionalProperties": false,
 "required": ["application_id", "protocol_id", "audit_id", "decision_id", "review_state", "proposal_sha256", "decision_sha256", "created_at", "artifacts", "applied_issue_ids", "skipped_issue_ids", "regression_fixtures"],
 "properties": {
 "application_id": {"$ref": "#/$defs/stable_id"},
 "application_mode": {"type": "string", "enum": ["patches", "compiled_roots"]},
 "protocol_id": {"$ref": "#/$defs/stable_id"},
 "audit_id": {"$ref": "#/$defs/stable_id"},
 "decision_id": {"$ref": "#/$defs/stable_id"},
 "review_state": {"type": "string", "enum": ["in_progress", "final"]},
 "proposal_sha256": {"$ref": "#/$defs/sha256"},
 "decision_sha256": {"$ref": "#/$defs/sha256"},
 "created_at": {"type": "string", "format": "date-time"},
 "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
 "applied_issue_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
 "incorporated_decision_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
 "skipped_issue_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}},
 "regression_fixtures": {"type": "array", "items": {"type": "string", "minLength": 1}}
 },
 "allOf": [
  {"if": {"properties": {"application_mode": {"const": "compiled_roots"}}, "required": ["application_mode"]}, "then": {"required": ["incorporated_decision_ids"]}}
 ],
 "$defs": {
 "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
 "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
 "artifact": {
 "type": "object", "additionalProperties": false,
 "required": ["source_id", "baseline_state", "candidate_path", "candidate_sha256"],
 "properties": {"source_id": {"$ref": "#/$defs/stable_id"}, "baseline_state": {"type": "string", "enum": ["present", "absent"]}, "baseline_path": {"type": "string", "minLength": 1}, "baseline_sha256": {"$ref": "#/$defs/sha256"}, "candidate_path": {"type": "string", "minLength": 1}, "candidate_sha256": {"$ref": "#/$defs/sha256"}},
 "allOf": [
 {"if": {"properties": {"baseline_state": {"const": "present"}}, "required": ["baseline_state"]}, "then": {"required": ["baseline_path", "baseline_sha256"]}, "else": {"not": {"anyOf": [{"required": ["baseline_path"]}, {"required": ["baseline_sha256"]}]}}}
 ]
 }
 }
}

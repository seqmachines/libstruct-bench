{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/audit_packet.schema.json",
  "title": "Ground-truth conversion or comparison packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "protocol_id", "phase", "materialization", "input_manifest", "files"],
  "properties": {
    "packet_id": {"$ref": "#/$defs/stable_id"},
    "protocol_id": {"$ref": "#/$defs/stable_id"},
    "phase": {"type": "string", "enum": ["legacy_conversion", "comparison"]},
    "materialization": {"type": "string", "enum": ["copy", "symlink"]},
    "input_manifest": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "source_sha256"],
      "properties": {"path": {"const": "manifest.json"}, "sha256": {"$ref": "#/$defs/sha256"}, "source_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "renditions": {"type": "array", "items": {"$ref": "#/$defs/rendition"}}
  },
  "allOf": [
    {"properties": {"files": {"contains": {"properties": {"role": {"const": "legacy_curated_html"}}, "required": ["role"]}, "minContains": 1}}},
    {"properties": {"files": {"contains": {"properties": {"role": {"const": "current_benchmark_record"}}, "required": ["role"]}, "minContains": 1}}},
    {
      "if": {"properties": {"phase": {"const": "comparison"}}, "required": ["phase"]},
      "then": {"properties": {"files": {"contains": {"properties": {"role": {"const": "primary_evidence"}}, "required": ["role"]}, "minContains": 1}}}
    },
    {
      "if": {"properties": {"phase": {"const": "legacy_conversion"}}, "required": ["phase"]},
      "then": {
        "properties": {
          "files": {
            "not": {
              "contains": {
                "properties": {"role": {"enum": ["primary_evidence", "benchmark_run_artifact", "legacy_conversion_candidate"]}},
                "required": ["role"]
              }
            }
          },
          "renditions": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "role", "source_kind", "path", "sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/stable_id"}, "role": {"type": "string", "enum": ["primary_evidence", "legacy_curated_html", "current_benchmark_record", "legacy_conversion_candidate", "benchmark_run_artifact"]},
        "source_kind": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"},
        "source_sha256": {"$ref": "#/$defs/sha256"}, "transformation": {"const": "tsv_row_filter"}
      },
      "allOf": [{"if": {"required": ["transformation"]}, "then": {"required": ["source_sha256"]}}, {"if": {"required": ["source_sha256"]}, "then": {"required": ["transformation"]}}]
    },
    "rendition": {
      "type": "object", "additionalProperties": false, "required": ["artifact_id", "source_id", "kind", "path", "sha256", "media_type"],
      "properties": {"artifact_id": {"$ref": "#/$defs/stable_id"}, "source_id": {"$ref": "#/$defs/stable_id"}, "kind": {"type": "string", "enum": ["native_text", "table_text", "page_image", "embedded_image"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "media_type": {"type": "string", "minLength": 1}, "page": {"type": "integer", "minimum": 1}, "sheet": {"type": "string", "minLength": 1}}
    }
  }
}

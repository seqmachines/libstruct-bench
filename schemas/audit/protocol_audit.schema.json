{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/protocol_audit.schema.json",
  "title": "Ground-truth protocol audit proposal",
  "description": "A legacy-derived T1-T3 conversion checked against primary sources in one read-only audit pass. This artifact proposes but never approves changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["audit_id", "protocol_id", "packet_sha256", "input_manifest_sha256", "baseline_artifacts", "run", "source_coverage", "disposition", "summary", "audited_fields", "issues"],
  "properties": {
    "audit_id": {"$ref": "#/$defs/stable_id"}, "protocol_id": {"$ref": "#/$defs/stable_id"},
    "packet_sha256": {"$ref": "#/$defs/sha256"}, "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact_hash"}},
    "run": {"$ref": "#/$defs/run"}, "subject_runs": {"type": "array", "items": {"$ref": "#/$defs/subject_run"}},
    "source_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_coverage"}},
    "disposition": {"type": "string", "enum": ["no_issues", "issues_proposed", "ambiguous", "insufficient_evidence"]},
    "summary": {"type": "string", "minLength": 1},
    "audited_fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/audited_field"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}}, "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"disposition": {"const": "no_issues"}}, "required": ["disposition"]}, "then": {"properties": {"issues": {"maxItems": 0}}}},
    {"if": {"properties": {"disposition": {"const": "issues_proposed"}}, "required": ["disposition"]}, "then": {"properties": {"issues": {"minItems": 1}}}}
  ],
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task": {"type": "string", "enum": ["T1", "T2", "T3", "cross_task"]},
    "artifact_hash": {"type": "object", "additionalProperties": false, "required": ["source_id", "sha256"], "properties": {"source_id": {"$ref": "#/$defs/stable_id"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "agent", "provider", "model", "tool_version", "harness_version", "review_mode", "started_at", "completed_at", "prompt_sha256", "skill_sha256", "policy_sha256", "schema_sha256", "skills", "tools", "permission_mode", "checkpoint_id"],
      "properties": {"run_id": {"$ref": "#/$defs/stable_id"}, "agent": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "tool_version": {"type": "string", "minLength": 1}, "harness_version": {"type": "string", "minLength": 1}, "review_mode": {"type": "string", "enum": ["primary", "independent"]}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "prompt_sha256": {"$ref": "#/$defs/sha256"}, "skill_sha256": {"$ref": "#/$defs/sha256"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "schema_sha256": {"$ref": "#/$defs/sha256"}, "skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "permission_mode": {"type": "string", "minLength": 1}, "checkpoint_id": {"$ref": "#/$defs/stable_id"}}
    },
    "subject_run": {"type": "object", "additionalProperties": false, "required": ["run_id", "agent", "model", "prompt_sha256", "skills", "tools", "harness_version"], "properties": {"run_id": {"$ref": "#/$defs/stable_id"}, "agent": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "prompt_sha256": {"$ref": "#/$defs/sha256"}, "skills": {"type": "array", "items": {"type": "string", "minLength": 1}}, "tools": {"type": "array", "items": {"type": "string", "minLength": 1}}, "harness_version": {"type": "string", "minLength": 1}}},
    "locator": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"page": {"type": "integer", "minimum": 1}, "page_end": {"type": "integer", "minimum": 1}, "section": {"type": "string", "minLength": 1}, "figure": {"type": "string", "minLength": 1}, "table": {"type": "string", "minLength": 1}, "sheet": {"type": "string", "minLength": 1}, "cell_range": {"type": "string", "minLength": 1}, "html_selector": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}}},
    "source_coverage": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "status", "tasks", "portions_reviewed"],
      "properties": {"source_id": {"$ref": "#/$defs/stable_id"}, "status": {"type": "string", "enum": ["reviewed", "unreadable", "not_relevant"]}, "tasks": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/task"}}, "portions_reviewed": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "notes": {"type": ["string", "null"]}},
      "allOf": [{"if": {"properties": {"status": {"const": "reviewed"}}, "required": ["status"]}, "then": {"properties": {"portions_reviewed": {"minItems": 1}}}}, {"if": {"properties": {"status": {"const": "unreadable"}}, "required": ["status"]}, "then": {"required": ["notes"]}}]
    },
    "evidence": {"type": "object", "additionalProperties": false, "required": ["source_id", "locator", "supports"], "properties": {"source_id": {"$ref": "#/$defs/stable_id"}, "locator": {"$ref": "#/$defs/locator"}, "supports": {"type": "string", "enum": ["current", "proposed", "alternative", "context"]}, "excerpt": {"type": ["string", "null"]}, "observed_sequence": {"type": ["string", "null"]}, "notes": {"type": ["string", "null"]}}},
    "transformation": {"type": "object", "additionalProperties": false, "required": ["operation", "input", "output", "rationale"], "properties": {"operation": {"type": "string", "enum": ["reverse_complement", "remove_direction_wrapper", "expand_homopolymer", "normalize_placeholder", "omit_biological_insert", "assemble_construct", "other"]}, "input": {}, "output": {}, "rationale": {"type": "string", "minLength": 1}}},
    "patch": {
      "type": "object", "additionalProperties": false, "required": ["op", "path"],
      "properties": {"op": {"type": "string", "enum": ["add", "remove", "replace", "test"]}, "path": {"type": "string", "pattern": "^(/([^~/]|~0|~1)*)*$"}, "value": {}},
      "allOf": [{"if": {"properties": {"op": {"enum": ["add", "replace", "test"]}}, "required": ["op"]}, "then": {"required": ["value"]}}, {"if": {"properties": {"op": {"const": "remove"}}, "required": ["op"]}, "then": {"not": {"required": ["value"]}}}]
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {"kind": {"type": "string", "enum": ["groundtruth_record", "new_groundtruth_record", "source_bundle", "normalization_policy", "evaluator", "agent_prediction", "agent_harness"]}, "artifact_source_id": {"$ref": "#/$defs/stable_id"}, "artifact_filename": {"type": "string", "enum": ["groundtruth_final_lib_struct.json", "groundtruth_oligos.json", "groundtruth_library_generation_workflow.json"]}, "json_pointer": {"type": "string", "pattern": "^(/([^~/]|~0|~1)*)*$"}},
      "allOf": [{"if": {"properties": {"kind": {"const": "new_groundtruth_record"}}, "required": ["kind"]}, "then": {"required": ["artifact_source_id", "artifact_filename", "json_pointer"], "properties": {"json_pointer": {"const": ""}}}}]
    },
    "audited_field": {
      "type": "object", "additionalProperties": false, "required": ["field_id", "task", "object_id", "field_path", "comparison_status", "issue_ids"],
      "properties": {"field_id": {"$ref": "#/$defs/stable_id"}, "task": {"$ref": "#/$defs/task"}, "object_id": {"$ref": "#/$defs/stable_id"}, "field_path": {"type": "string", "pattern": "^(/([^~/]|~0|~1)*)+$"}, "comparison_status": {"type": "string", "enum": ["verified_no_change", "proposed_correction", "missing_source_evidence", "ambiguous", "external_knowledge_required"]}, "issue_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}},
      "allOf": [{"if": {"properties": {"comparison_status": {"const": "verified_no_change"}}, "required": ["comparison_status"]}, "then": {"properties": {"issue_ids": {"maxItems": 0}}}, "else": {"properties": {"issue_ids": {"minItems": 1}}}}]
    },
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["issue_id", "task", "field_id", "category", "defect_type", "responsibility", "severity", "title", "target", "current_value", "proposed_value", "support_status", "evidence", "transformations", "explanation", "recommendation", "proposed_patch", "confidence", "run_id", "checkpoint_id"],
      "properties": {
        "issue_id": {"$ref": "#/$defs/stable_id"}, "task": {"$ref": "#/$defs/task"}, "field_id": {"$ref": "#/$defs/stable_id"},
        "category": {"type": "string", "enum": ["source_or_evidence_missing", "source_conflict", "human_curation_error", "agent_reasoning_error", "agent_harness_or_context_error", "pdf_or_table_extraction_error", "formatting_or_schema_error", "naming_or_normalization_inconsistency", "protocol_version_confusion", "benchmark_policy_ambiguity", "evaluator_or_matching_error", "unresolved_scientific_ambiguity", "other"]},
        "defect_type": {"type": "string", "enum": ["incorrect_sequence", "variable_region_length", "strand_orientation", "strand_architecture", "schematic_final_product_conflict", "missing_final_library", "incomplete_workflow", "incorrect_oligo_metadata", "identifier_assignment", "source_scope", "other"]},
        "responsibility": {"type": "string", "enum": ["human_curation", "benchmark_agent", "audit_agent", "parser", "harness", "policy", "evaluator", "source_bundle", "unresolved"]},
        "severity": {"type": "string", "enum": ["blocker", "high", "medium", "low"]}, "title": {"type": "string", "minLength": 1}, "target": {"$ref": "#/$defs/target"},
        "current_value": {}, "proposed_value": {}, "support_status": {"type": "string", "enum": ["explicit", "derivable", "externally_completed", "ambiguous", "unsupported"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "transformations": {"type": "array", "items": {"$ref": "#/$defs/transformation"}},
        "explanation": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "enum": ["keep_current", "propose_change", "add_source", "revise_policy", "fix_evaluator", "fix_harness", "exclude_from_scoring", "needs_human_review"]},
        "proposed_patch": {"type": "array", "items": {"$ref": "#/$defs/patch"}}, "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "run_id": {"$ref": "#/$defs/stable_id"}, "checkpoint_id": {"$ref": "#/$defs/stable_id"}, "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"recommendation": {"const": "propose_change"}}, "required": ["recommendation"]}, "then": {"properties": {"proposed_patch": {"minItems": 1}, "target": {"properties": {"kind": {"enum": ["groundtruth_record", "new_groundtruth_record"]}}, "required": ["kind", "artifact_source_id"]}}}, "else": {"properties": {"proposed_patch": {"maxItems": 0}}}},
        {"if": {"properties": {"support_status": {"enum": ["explicit", "derivable", "externally_completed"]}}, "required": ["support_status"]}, "then": {"properties": {"evidence": {"minItems": 1}}}}
      ]
    }
  }
}

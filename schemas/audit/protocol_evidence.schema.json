{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/protocol_evidence.schema.json",
  "title": "Primary-source protocol evidence",
  "description": "Source-supported T1, T2, and T3 reconstruction created before legacy curation or current ground truth is visible.",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "protocol_id", "packet_sha256", "input_manifest_sha256", "run", "source_coverage", "t1", "t2", "t3", "summary"],
  "properties": {
    "evidence_id": {"$ref": "#/$defs/stable_id"},
    "protocol_id": {"$ref": "#/$defs/stable_id"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "run": {"$ref": "#/$defs/run"},
    "source_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_coverage"}},
    "t1": {"type": "object", "additionalProperties": false, "required": ["libraries"], "properties": {"libraries": {"type": "array", "items": {"$ref": "#/$defs/library"}}, "notes": {"type": ["string", "null"]}}},
    "t2": {"type": "object", "additionalProperties": false, "required": ["oligos"], "properties": {"oligos": {"type": "array", "items": {"$ref": "#/$defs/oligo"}}, "notes": {"type": ["string", "null"]}}},
    "t3": {"type": "object", "additionalProperties": false, "required": ["workflows"], "properties": {"workflows": {"type": "array", "items": {"$ref": "#/$defs/workflow"}}, "notes": {"type": ["string", "null"]}}},
    "summary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["run_id", "agent", "provider", "model", "tool_version", "harness_version", "review_mode", "started_at", "completed_at", "prompt_sha256", "skill_sha256", "policy_sha256", "schema_sha256", "skills", "tools", "permission_mode", "checkpoint_id"],
      "properties": {
        "run_id": {"$ref": "#/$defs/stable_id"}, "agent": {"type": "string", "minLength": 1}, "provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1}, "harness_version": {"type": "string", "minLength": 1}, "review_mode": {"type": "string", "enum": ["primary", "independent"]},
        "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"}, "skill_sha256": {"$ref": "#/$defs/sha256"}, "policy_sha256": {"$ref": "#/$defs/sha256"}, "schema_sha256": {"$ref": "#/$defs/sha256"},
        "skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "permission_mode": {"type": "string", "minLength": 1}, "checkpoint_id": {"$ref": "#/$defs/stable_id"}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"page": {"type": "integer", "minimum": 1}, "page_end": {"type": "integer", "minimum": 1}, "section": {"type": "string", "minLength": 1}, "figure": {"type": "string", "minLength": 1}, "table": {"type": "string", "minLength": 1}, "sheet": {"type": "string", "minLength": 1}, "cell_range": {"type": "string", "minLength": 1}, "line": {"type": "integer", "minimum": 1}}
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "locator"],
      "properties": {"source_id": {"$ref": "#/$defs/stable_id"}, "locator": {"$ref": "#/$defs/locator"}, "excerpt": {"type": ["string", "null"]}, "observed_sequence": {"type": ["string", "null"]}, "notes": {"type": ["string", "null"]}}
    },
    "transformation": {
      "type": "object", "additionalProperties": false, "required": ["operation", "input", "output", "rationale"],
      "properties": {"operation": {"type": "string", "enum": ["reverse_complement", "remove_direction_wrapper", "expand_homopolymer", "normalize_placeholder", "omit_biological_insert", "assemble_construct", "other"]}, "input": {}, "output": {}, "rationale": {"type": "string", "minLength": 1}}
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "field_path", "value", "support_status", "evidence", "transformations", "confidence"],
      "properties": {
        "field_id": {"$ref": "#/$defs/stable_id"}, "field_path": {"type": "string", "pattern": "^(/([^~/]|~0|~1)*)+$"}, "value": {},
        "support_status": {"type": "string", "enum": ["explicit", "derivable", "externally_completed", "ambiguous", "unsupported"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "transformations": {"type": "array", "items": {"$ref": "#/$defs/transformation"}},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]}, "notes": {"type": ["string", "null"]}
      },
      "allOf": [{"if": {"properties": {"support_status": {"enum": ["explicit", "derivable", "externally_completed"]}}, "required": ["support_status"]}, "then": {"properties": {"evidence": {"minItems": 1}}}}]
    },
    "source_coverage": {
      "type": "object", "additionalProperties": false, "required": ["source_id", "status", "tasks", "portions_reviewed"],
      "properties": {"source_id": {"$ref": "#/$defs/stable_id"}, "status": {"type": "string", "enum": ["reviewed", "unreadable", "not_relevant"]}, "tasks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["T1", "T2", "T3", "cross_task"]}}, "portions_reviewed": {"type": "array", "items": {"$ref": "#/$defs/locator"}}, "notes": {"type": ["string", "null"]}},
      "allOf": [{"if": {"properties": {"status": {"const": "reviewed"}}, "required": ["status"]}, "then": {"properties": {"portions_reviewed": {"minItems": 1}}}}, {"if": {"properties": {"status": {"const": "unreadable"}}, "required": ["status"]}, "then": {"required": ["notes"]}}]
    },
    "library": {"type": "object", "additionalProperties": false, "required": ["library_id", "modality", "fields"], "properties": {"library_id": {"$ref": "#/$defs/stable_id"}, "modality": {"type": "string", "minLength": 1}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}, "notes": {"type": ["string", "null"]}}},
    "oligo": {"type": "object", "additionalProperties": false, "required": ["oligo_id", "source_names", "fields"], "properties": {"oligo_id": {"$ref": "#/$defs/stable_id"}, "source_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}, "notes": {"type": ["string", "null"]}}},
    "oligo_derivation": {
      "type": "object", "additionalProperties": false, "required": ["oligo_id", "orientation_to_source"],
      "properties": {"oligo_id": {"$ref": "#/$defs/stable_id"}, "orientation_to_source": {"type": "string", "enum": ["same_orientation", "reverse_complement", "unknown"]}, "notes": {"type": ["string", "null"]}}
    },
    "placeholder": {
      "type": "string", "minLength": 1,
      "pattern": "^\\[(?![A-Z0-9_]*(?:_RC|_REVCOMP|_REVERSE_COMPLEMENT|_FWD|_FORWARD|_REV|_REVERSE):)[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*:[1-9][0-9]*\\]$",
      "description": "Canonical [ROLE:LENGTH] placeholder. ROLE describes biology only and must not encode strand orientation."
    },
    "architecture_segment": {
      "type": "object", "additionalProperties": false, "required": ["segment_id", "role", "structural_role"],
      "properties": {
        "segment_id": {"$ref": "#/$defs/stable_id"},
        "role": {"type": "string", "minLength": 1},
        "structural_role": {"type": "string", "enum": ["paired_region", "five_prime_overhang", "three_prime_overhang", "internal_unpaired", "unpaired", "mixed", "unknown"]},
        "sequence": {"type": "string", "minLength": 1},
        "length": {"type": "integer", "minimum": 1},
        "placeholder": {"$ref": "#/$defs/placeholder"},
        "oligo_derivations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/oligo_derivation"}},
        "notes": {"type": ["string", "null"]}
      },
      "anyOf": [{"required": ["sequence"]}, {"required": ["length"]}, {"required": ["placeholder"]}]
    },
    "strand": {
      "type": "object", "additionalProperties": false,
      "required": ["strand_id", "name", "molecule_type", "orientation", "segments"],
      "properties": {
        "strand_id": {"$ref": "#/$defs/stable_id"},
        "name": {"type": "string", "minLength": 1},
        "molecule_type": {"type": "string", "enum": ["DNA", "RNA", "other", "unknown"]},
        "orientation": {"const": "5_to_3"},
        "sequence_architecture": {"type": "string", "minLength": 1},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/architecture_segment"}},
        "notes": {"type": ["string", "null"]}
      }
    },
    "paired_region_side": {
      "type": "object", "additionalProperties": false, "required": ["strand_id", "segment_ids"],
      "properties": {"strand_id": {"$ref": "#/$defs/stable_id"}, "segment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}}
    },
    "paired_region": {
      "type": "object", "additionalProperties": false, "required": ["paired_region_id", "side_1", "side_2", "relationship"],
      "properties": {"paired_region_id": {"$ref": "#/$defs/stable_id"}, "side_1": {"$ref": "#/$defs/paired_region_side"}, "side_2": {"$ref": "#/$defs/paired_region_side"}, "relationship": {"type": "string", "enum": ["reverse_complementary", "documented_noncanonical", "unknown"]}, "notes": {"type": ["string", "null"]}}
    },
    "discontinuity": {
      "type": "object", "additionalProperties": false, "required": ["discontinuity_id", "strand_id", "after_segment_id", "before_segment_id", "kind"],
      "properties": {"discontinuity_id": {"$ref": "#/$defs/stable_id"}, "strand_id": {"$ref": "#/$defs/stable_id"}, "after_segment_id": {"$ref": "#/$defs/stable_id"}, "before_segment_id": {"$ref": "#/$defs/stable_id"}, "kind": {"type": "string", "enum": ["nick", "gap", "break", "unknown"]}, "notes": {"type": ["string", "null"]}}
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["state_id", "strand_architecture", "reference_strand_id", "strands", "paired_regions", "discontinuities", "fields"],
      "properties": {
        "state_id": {"$ref": "#/$defs/stable_id"},
        "strand_architecture": {"type": "string", "enum": ["single_stranded", "double_stranded", "partially_duplex", "rna_dna_hybrid", "y_shaped_duplex", "mixed_population", "unknown"]},
        "reference_strand_id": {"$ref": "#/$defs/stable_id"},
        "strands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/strand"}},
        "paired_regions": {"type": "array", "items": {"$ref": "#/$defs/paired_region"}},
        "discontinuities": {"type": "array", "items": {"$ref": "#/$defs/discontinuity"}},
        "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
        "notes": {"type": ["string", "null"]}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["transition_id", "substrate_state_ids", "product_state_ids", "carried_forward_product_ids", "discarded_product_ids", "oligo_ids", "fields"],
      "properties": {"transition_id": {"$ref": "#/$defs/stable_id"}, "substrate_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "product_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "carried_forward_product_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "discarded_product_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "oligo_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}, "notes": {"type": ["string", "null"]}}
    },
    "workflow": {
      "type": "object", "additionalProperties": false,
      "required": ["workflow_id", "modality", "states", "transitions", "initial_state_ids", "final_state_ids", "fields"],
      "properties": {"workflow_id": {"$ref": "#/$defs/stable_id"}, "modality": {"type": "string", "minLength": 1}, "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}, "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}}, "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}, "initial_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "final_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}, "notes": {"type": ["string", "null"]}}
    }
  }
}

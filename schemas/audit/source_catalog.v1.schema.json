{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/source_catalog.v1.schema.json",
  "title": "Ground-truth audit source catalog v1",
  "description": "Reviewed inventory of every discovered, expected, excluded, or unavailable source for the protocol audit corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "created_at", "datasets", "protocols"],
  "properties": {
    "schema_version": {"const": "libstruct.source_catalog.v1"},
    "catalog_id": {"$ref": "#/$defs/stable_id"},
    "created_at": {"type": "string", "format": "date-time"},
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dataset"}
    },
    "protocols": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protocol"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "provider", "repository", "revision"],
      "properties": {
        "dataset_id": {"$ref": "#/$defs/stable_id"},
        "provider": {"type": "string", "enum": ["huggingface", "git", "local_fixture"]},
        "repository": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 7},
        "repo_type": {"type": "string", "enum": ["dataset", "model", "git"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "reviewed_at", "reason"],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/stable_id"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "role", "source_kind", "approval_status", "task_relevance"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/stable_id"},
        "role": {
          "type": "string",
          "enum": [
            "primary_evidence", "legacy_curated_html", "current_benchmark_record",
            "benchmark_run_artifact"
          ]
        },
        "source_kind": {
          "type": "string",
          "enum": [
            "original_paper", "supplementary_methods", "protocol_document",
            "oligo_table", "figure_or_diagram", "vendor_source",
            "cited_method_source", "legacy_html", "legacy_asset",
            "current_t1", "current_t2", "current_t3", "oligo_tsv_baseline",
            "benchmark_prediction", "benchmark_trace", "evaluator_output",
            "other", "unclassified"
          ]
        },
        "approval_status": {
          "type": "string",
          "enum": ["pending", "included", "excluded", "unavailable"]
        },
        "task_relevance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["T1", "T2", "T3", "cross_task"]}
        },
        "dataset_id": {"$ref": "#/$defs/stable_id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "declared_sha256": {"$ref": "#/$defs/sha256"},
        "integrity_status": {"type": "string", "enum": ["matched", "mismatch", "missing"]},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {"type": "string", "minLength": 1},
        "title": {"type": ["string", "null"]},
        "document_version": {"type": ["string", "null"]},
        "original_uri": {"type": ["string", "null"], "format": "uri"},
        "related_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "row_filter": {"$ref": "#/$defs/row_filter"},
        "review": {"$ref": "#/$defs/review"},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"approval_status": {"const": "included"}}, "required": ["approval_status"]},
          "then": {"required": ["dataset_id", "path", "sha256", "size_bytes", "media_type", "review"]}
        },
        {
          "if": {"properties": {"approval_status": {"enum": ["excluded", "unavailable"]}}, "required": ["approval_status"]},
          "then": {"required": ["review"]}
        },
        {
          "if": {"properties": {"approval_status": {"const": "pending"}}, "required": ["approval_status"]},
          "then": {"not": {"required": ["review"]}}
        }
      ]
    },
    "row_filter": {
      "type": "object", "additionalProperties": false,
      "required": ["column", "value", "include_source_row_number"],
      "properties": {"column": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "include_source_row_number": {"const": true}}
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "sources"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "display_name": {"type": ["string", "null"]},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/review_decision.v1.schema.json",
  "title": "Human audit review decision v1",
  "description": "Issue-level human adjudication of an immutable protocol audit proposal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "protocol_id",
    "audit_id",
    "proposal_sha256",
    "baseline_artifacts",
    "reviewer",
    "decided_at",
    "overall_disposition",
    "issue_decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "libstruct.review_decision.v1"
    },
    "decision_id": {
      "$ref": "#/$defs/stable_id"
    },
    "protocol_id": {
      "$ref": "#/$defs/stable_id"
    },
    "audit_id": {
      "$ref": "#/$defs/stable_id"
    },
    "proposal_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "baseline_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact_hash"
      }
    },
    "reviewer": {
      "$ref": "#/$defs/reviewer"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "overall_disposition": {
      "type": "string",
      "enum": [
        "confirmed",
        "accepted",
        "rejected",
        "partially_accepted",
        "needs_more_evidence",
        "deferred"
      ]
    },
    "issue_decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue_decision"
      }
    },
    "review_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_disposition": {
            "const": "confirmed"
          }
        },
        "required": [
          "overall_disposition"
        ]
      },
      "then": {
        "properties": {
          "issue_decisions": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "issue_decisions": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer_id"
      ],
      "properties": {
        "reviewer_id": {
          "$ref": "#/$defs/stable_id"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "organization": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "issue_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "disposition",
        "rationale"
      ],
      "properties": {
        "issue_id": {
          "$ref": "#/$defs/stable_id"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "rejected",
            "needs_more_evidence",
            "deferred"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

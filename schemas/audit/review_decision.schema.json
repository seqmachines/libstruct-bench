{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/review_decision.schema.json",
  "title": "Human ground-truth audit decision",
  "oneOf": [
    {"$ref": "#/$defs/patch_review"},
    {"$ref": "#/$defs/compiled_review"}
  ],
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "task": {"type": "string", "enum": ["T1", "T2", "T3", "cross_task"]},
    "target_kind": {
      "type": "string",
      "enum": [
        "groundtruth_record",
        "new_groundtruth_record",
        "source_bundle",
        "normalization_policy",
        "evaluator",
        "agent_prediction",
        "agent_harness"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": ["accept", "reject", "modify", "unresolved", "exclude"]
    },
    "overall_disposition": {
      "type": "string",
      "enum": [
        "in_progress",
        "confirmed",
        "accepted",
        "rejected",
        "partially_accepted",
        "unresolved",
        "excluded"
      ]
    },
    "confirmed_cause": {
      "type": "string",
      "enum": [
        "original_human_curation_error",
        "audit_agent_reasoning_error",
        "agent_harness_or_context_error",
        "pdf_table_or_figure_extraction_error",
        "schema_or_formatting_error",
        "naming_or_normalization_inconsistency",
        "source_or_protocol_ambiguity",
        "protocol_version_error"
      ]
    },
    "legacy_compiled_cause": {
      "type": "string",
      "enum": [
        "original_human_curation_error",
        "audit_agent_reasoning_error",
        "agent_harness_or_context_error",
        "pdf_table_or_figure_extraction_error",
        "schema_or_formatting_error",
        "naming_or_normalization_inconsistency",
        "source_or_protocol_ambiguity",
        "protocol_version_error",
        "human_curation_error",
        "source_or_evidence_missing"
      ]
    },
    "artifact_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "sha256"],
      "properties": {
        "source_id": {"$ref": "#/$defs/stable_id"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id"],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/stable_id"},
        "name": {"type": ["string", "null"]},
        "organization": {"type": ["string", "null"]}
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": {"type": "string", "enum": ["add", "remove", "replace", "test"]},
        "path": {"type": "string", "pattern": "^(/([^~/]|~0|~1)*)*$"},
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {"op": {"enum": ["add", "replace", "test"]}},
            "required": ["op"]
          },
          "then": {"required": ["value"]}
        },
        {
          "if": {"properties": {"op": {"const": "remove"}}, "required": ["op"]},
          "then": {"not": {"required": ["value"]}}
        }
      ]
    },
    "issue_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue_id", "disposition", "rationale"],
      "properties": {
        "issue_id": {"$ref": "#/$defs/stable_id"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "rationale": {"type": "string", "minLength": 1},
        "replacement_value": {},
        "replacement_patch": {
          "type": "array",
          "items": {"$ref": "#/$defs/patch"}
        },
        "category": {
          "type": "string",
          "enum": [
            "source_or_evidence_missing",
            "source_conflict",
            "human_curation_error",
            "agent_reasoning_error",
            "agent_harness_or_context_error",
            "pdf_or_table_extraction_error",
            "formatting_or_schema_error",
            "naming_or_normalization_inconsistency",
            "protocol_version_confusion",
            "benchmark_policy_ambiguity",
            "evaluator_or_matching_error",
            "unresolved_scientific_ambiguity",
            "other"
          ]
        },
        "responsibility": {
          "type": "string",
          "enum": [
            "human_curation",
            "benchmark_agent",
            "audit_agent",
            "parser",
            "harness",
            "policy",
            "evaluator",
            "source_bundle",
            "unresolved"
          ]
        },
        "severity": {"type": "string", "enum": ["blocker", "high", "medium", "low"]},
        "confirmed_cause": {"$ref": "#/$defs/confirmed_cause"},
        "exclusion_scope": {"type": "string", "enum": ["field", "task", "protocol"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"disposition": {"const": "modify"}},
            "required": ["disposition"]
          },
          "then": {
            "required": ["replacement_value", "replacement_patch"],
            "properties": {"replacement_patch": {"minItems": 1}}
          },
          "else": {"properties": {"replacement_patch": {"maxItems": 0}}}
        },
        {
          "if": {
            "properties": {"disposition": {"const": "exclude"}},
            "required": ["disposition"]
          },
          "then": {"required": ["exclusion_scope"]}
        }
      ]
    },
    "patch_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "protocol_id",
        "audit_id",
        "proposal_sha256",
        "baseline_artifacts",
        "reviewer",
        "iteration",
        "review_state",
        "review_started_at",
        "review_completed_at",
        "overall_disposition",
        "issue_decisions"
      ],
      "properties": {
        "decision_id": {"$ref": "#/$defs/stable_id"},
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "audit_id": {"$ref": "#/$defs/stable_id"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_hash"}
        },
        "reviewer": {"$ref": "#/$defs/reviewer"},
        "iteration": {"type": "integer", "minimum": 1},
        "review_state": {"type": "string", "enum": ["in_progress", "final"]},
        "review_started_at": {"type": "string", "format": "date-time"},
        "review_completed_at": {"type": "string", "format": "date-time"},
        "review_duration_seconds": {"type": "number", "minimum": 0},
        "overall_disposition": {"$ref": "#/$defs/overall_disposition"},
        "issue_decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/issue_decision"}
        },
        "review_notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"review_state": {"const": "in_progress"}},
            "required": ["review_state"]
          },
          "then": {"properties": {"overall_disposition": {"const": "in_progress"}}}
        },
        {
          "if": {
            "properties": {"overall_disposition": {"const": "confirmed"}},
            "required": ["overall_disposition"]
          },
          "then": {"properties": {"issue_decisions": {"maxItems": 0}}}
        }
      ]
    },
    "compiled_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "task",
        "target_kind",
        "disposition",
        "confirmed_cause",
        "rationale",
        "decided_at"
      ],
      "properties": {
        "issue_id": {"$ref": "#/$defs/stable_id"},
        "task": {"$ref": "#/$defs/task"},
        "target_kind": {"$ref": "#/$defs/target_kind"},
        "disposition": {"$ref": "#/$defs/disposition"},
        "confirmed_cause": {"$ref": "#/$defs/legacy_compiled_cause"},
        "rationale": {"type": "string", "minLength": 1},
        "decided_at": {
          "anyOf": [
            {"type": "string", "format": "date"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "decision_stage": {
          "type": "string",
          "enum": ["proposal", "t3_source_fact_check", "final_consistency_check"]
        },
        "exclusion_scope": {"type": "string", "enum": ["field", "task", "protocol"]}
      },
      "allOf": [
        {
          "if": {
            "properties": {"disposition": {"const": "exclude"}},
            "required": ["disposition"]
          },
          "then": {"required": ["exclusion_scope"]}
        }
      ]
    },
    "candidate_sha256": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "T1": {"$ref": "#/$defs/sha256"},
        "T2": {"$ref": "#/$defs/sha256"},
        "T3": {"$ref": "#/$defs/sha256"}
      }
    },
    "scientific_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["granted", "granted_at", "scope"],
      "properties": {
        "granted": {"type": "boolean"},
        "granted_at": {"type": "string", "format": "date-time"},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "compiled_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "protocol_id",
        "audit_id",
        "iteration",
        "review_state",
        "review_batch",
        "issue_order",
        "deferred_root_issues",
        "decisions",
        "overall_disposition",
        "reviewer"
      ],
      "properties": {
        "decision_id": {"$ref": "#/$defs/stable_id"},
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "audit_id": {"$ref": "#/$defs/stable_id"},
        "source_run": {"type": "string", "minLength": 1},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "baseline_artifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/artifact_hash"}
        },
        "iteration": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "string", "pattern": "^iteration-[0-9]+$"}
          ]
        },
        "review_state": {"type": "string", "enum": ["in_progress", "final"]},
        "review_batch": {"type": "string", "minLength": 1},
        "issue_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "deferred_root_issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stable_id"}
        },
        "decisions": {
          "type": "array",
          "items": {"$ref": "#/$defs/compiled_decision"}
        },
        "overall_disposition": {"$ref": "#/$defs/overall_disposition"},
        "review_started_at": {"type": "string", "format": "date-time"},
        "review_completed_at": {"type": "string", "format": "date-time"},
        "reviewer": {"type": "string", "minLength": 1},
        "candidate_sha256": {"$ref": "#/$defs/candidate_sha256"},
        "scientific_approval": {"$ref": "#/$defs/scientific_approval"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"review_state": {"const": "in_progress"}},
            "required": ["review_state"]
          },
          "then": {"properties": {"overall_disposition": {"const": "in_progress"}}}
        },
        {
          "if": {
            "properties": {"review_state": {"const": "final"}},
            "required": ["review_state"]
          },
          "then": {
            "required": ["review_completed_at", "candidate_sha256", "scientific_approval"],
            "properties": {
              "scientific_approval": {
                "properties": {"granted": {"const": true}},
                "required": ["granted"]
              }
            }
          }
        }
      ]
    }
  }
}

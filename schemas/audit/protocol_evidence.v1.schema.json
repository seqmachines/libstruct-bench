{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/protocol_evidence.v1.schema.json",
  "title": "Primary-source protocol evidence v1",
  "description": "Evidence-first T1/T2/T3 extraction produced before legacy or benchmark records are visible.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "protocol_id", "packet_sha256",
    "input_manifest_sha256", "run", "source_coverage", "t1", "t2", "t3", "summary"
  ],
  "properties": {
    "schema_version": {"const": "libstruct.protocol_evidence.v1"},
    "evidence_id": {"$ref": "#/$defs/stable_id"},
    "protocol_id": {"$ref": "#/$defs/stable_id"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "run": {"$ref": "#/$defs/run"},
    "source_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_coverage"}},
    "t1": {
      "type": "object", "additionalProperties": false, "required": ["libraries"],
      "properties": {"libraries": {"type": "array", "items": {"$ref": "#/$defs/library"}}, "notes": {"type": ["string", "null"]}}
    },
    "t2": {
      "type": "object", "additionalProperties": false, "required": ["oligos"],
      "properties": {"oligos": {"type": "array", "items": {"$ref": "#/$defs/oligo"}}, "notes": {"type": ["string", "null"]}}
    },
    "t3": {
      "type": "object", "additionalProperties": false, "required": ["workflows"],
      "properties": {"workflows": {"type": "array", "items": {"$ref": "#/$defs/workflow"}}, "notes": {"type": ["string", "null"]}}
    },
    "summary": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": [
        "run_id", "agent", "provider", "model", "tool_version", "harness_version",
        "review_mode", "started_at", "completed_at", "prompt_sha256", "skill_sha256",
        "policy_sha256", "schema_sha256", "skills", "tools", "permission_mode", "checkpoint_id"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/stable_id"},
        "agent": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "tool_version": {"type": "string", "minLength": 1},
        "harness_version": {"type": "string", "minLength": 1},
        "review_mode": {"type": "string", "enum": ["primary", "independent"]},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "prompt_sha256": {"$ref": "#/$defs/sha256"},
        "skill_sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "permission_mode": {"type": "string", "minLength": 1},
        "checkpoint_id": {"$ref": "#/$defs/stable_id"}
      }
    },
    "locator": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "page_end": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "figure": {"type": "string", "minLength": 1},
        "table": {"type": "string", "minLength": 1},
        "sheet": {"type": "string", "minLength": 1},
        "cell_range": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": {"$ref": "#/$defs/stable_id"},
        "locator": {"$ref": "#/$defs/locator"},
        "excerpt": {"type": ["string", "null"]},
        "observed_sequence": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      }
    },
    "transformation": {
      "type": "object", "additionalProperties": false,
      "required": ["operation", "input", "output", "rationale"],
      "properties": {
        "operation": {"type": "string", "enum": ["reverse_complement", "remove_direction_wrapper", "expand_homopolymer", "normalize_placeholder", "omit_biological_insert", "assemble_construct", "other"]},
        "input": {}, "output": {}, "rationale": {"type": "string", "minLength": 1}
      }
    },
    "field": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "field_path", "value", "support_status", "evidence", "transformations", "confidence"],
      "properties": {
        "field_id": {"$ref": "#/$defs/stable_id"},
        "field_path": {"type": "string", "pattern": "^(/([^~/]|~0|~1)*)+$"},
        "value": {},
        "support_status": {"type": "string", "enum": ["explicit", "derivable", "externally_completed", "ambiguous", "unsupported"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "transformations": {"type": "array", "items": {"$ref": "#/$defs/transformation"}},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"support_status": {"enum": ["explicit", "derivable", "externally_completed"]}}, "required": ["support_status"]}, "then": {"properties": {"evidence": {"minItems": 1}}}}
      ]
    },
    "source_coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "status", "tasks", "portions_reviewed"],
      "properties": {
        "source_id": {"$ref": "#/$defs/stable_id"},
        "status": {"type": "string", "enum": ["reviewed", "unreadable", "not_relevant"]},
        "tasks": {"type": "array", "uniqueItems": true, "items": {"type": "string", "enum": ["T1", "T2", "T3", "cross_task"]}},
        "portions_reviewed": {"type": "array", "items": {"$ref": "#/$defs/locator"}},
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "reviewed"}}, "required": ["status"]}, "then": {"properties": {"portions_reviewed": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"const": "unreadable"}}, "required": ["status"]}, "then": {"required": ["notes"]}}
      ]
    },
    "library": {
      "type": "object", "additionalProperties": false, "required": ["library_id", "modality", "fields"],
      "properties": {"library_id": {"$ref": "#/$defs/stable_id"}, "modality": {"type": "string", "minLength": 1}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}, "notes": {"type": ["string", "null"]}}
    },
    "oligo": {
      "type": "object", "additionalProperties": false, "required": ["oligo_id", "source_names", "fields"],
      "properties": {"oligo_id": {"$ref": "#/$defs/stable_id"}, "source_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}, "notes": {"type": ["string", "null"]}}
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["step_id", "order", "fields"],
      "properties": {"step_id": {"$ref": "#/$defs/stable_id"}, "order": {"type": "integer", "minimum": 1}, "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}}, "notes": {"type": ["string", "null"]}}
    },
    "workflow": {
      "type": "object", "additionalProperties": false, "required": ["workflow_id", "modality", "steps", "fields"],
      "properties": {"workflow_id": {"$ref": "#/$defs/stable_id"}, "modality": {"type": "string", "minLength": 1}, "fields": {"type": "array", "items": {"$ref": "#/$defs/field"}}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "notes": {"type": ["string", "null"]}}
    }
  }
}

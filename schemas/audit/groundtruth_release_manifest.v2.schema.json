{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/groundtruth_release_manifest.v2.schema.json",
  "title": "Audited ground-truth release manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "version", "release_status", "created_at", "generated_by", "source_datasets", "policies", "schemas", "checkpoints", "independent_audit", "protocols", "oligo_outputs"],
  "properties": {
    "schema_version": {"const": "libstruct.groundtruth_release_manifest.v2"},
    "release_id": {"$ref": "#/$defs/stable_id"},
    "version": {"type": "string", "minLength": 1},
    "release_status": {"type": "string", "enum": ["candidate", "frozen"]},
    "created_at": {"type": "string", "format": "date-time"},
    "generated_by": {
      "type": "object", "additionalProperties": false, "required": ["tool_version", "git_commit"],
      "properties": {"tool_version": {"type": "string", "minLength": 1}, "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}
    },
    "source_datasets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset"}},
    "policies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_hash"}},
    "schemas": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/schema_hash"}},
    "checkpoints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/checkpoint"}},
    "independent_audit": {"type": "object", "additionalProperties": false, "required": ["seed", "sample_fraction", "selected_protocol_ids"], "properties": {"seed": {"type": "string", "minLength": 1}, "sample_fraction": {"const": 0.1}, "selected_protocol_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/stable_id"}}}},
    "protocols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/protocol"}},
    "oligo_outputs": {"type": "object", "additionalProperties": false, "required": ["catalog_path", "catalog_sha256", "tsv_path", "tsv_sha256", "build_metadata_path", "build_metadata_sha256"], "properties": {"catalog_path": {"type": "string", "minLength": 1}, "catalog_sha256": {"$ref": "#/$defs/sha256"}, "tsv_path": {"type": "string", "minLength": 1}, "tsv_sha256": {"$ref": "#/$defs/sha256"}, "build_metadata_path": {"type": "string", "minLength": 1}, "build_metadata_sha256": {"$ref": "#/$defs/sha256"}}},
    "metrics": {"type": "object"}
  },
  "$defs": {
    "stable_id": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["provider", "repository", "revision"], "properties": {"provider": {"type": "string", "enum": ["huggingface", "git"]}, "repository": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 7}}},
    "file_hash": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "schema_hash": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "schema_version"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "schema_version": {"type": "string", "minLength": 1}}},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["checkpoint_id", "reviewed_protocol_count", "report_path", "report_sha256"], "properties": {"checkpoint_id": {"$ref": "#/$defs/stable_id"}, "reviewed_protocol_count": {"type": "integer", "minimum": 0}, "report_path": {"type": "string", "minLength": 1}, "report_sha256": {"$ref": "#/$defs/sha256"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["task", "path", "sha256", "schema_version", "artifact_source_id"], "properties": {"task": {"type": "string", "enum": ["T1", "T2", "T3", "oligo_catalog"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "schema_version": {"type": "string", "minLength": 1}, "artifact_source_id": {"$ref": "#/$defs/stable_id"}}},
    "protocol": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol_id", "task_dispositions", "input_manifest_sha256", "evidence_ids", "audit_ids", "independent_audit_ids", "decision_ids", "application_ids", "artifacts", "unresolved_issue_ids", "limitations"],
      "properties": {
        "protocol_id": {"$ref": "#/$defs/stable_id"},
        "task_dispositions": {"type": "object", "additionalProperties": false, "required": ["T1", "T2", "T3"], "properties": {"T1": {"type": "string", "enum": ["included", "excluded", "unresolved"]}, "T2": {"type": "string", "enum": ["included", "excluded", "unresolved"]}, "T3": {"type": "string", "enum": ["included", "excluded", "unresolved"]}}},
        "input_manifest_sha256": {"$ref": "#/$defs/sha256"}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stable_id"}}, "audit_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stable_id"}}, "independent_audit_ids": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}}, "decision_ids": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}}, "application_ids": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}}, "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}, "unresolved_issue_ids": {"type": "array", "items": {"$ref": "#/$defs/stable_id"}}, "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/kb_adjudicator_output.schema.json",
  "title": "Local Codex output for one KB training adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "training_ordinal", "findings", "pact_proposal", "review_summary"],
  "properties": {
    "schema_version": {"type": "string", "const": "libstruct.libgen_kb_adjudicator_output.v1"},
    "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "training_ordinal": {"type": "integer", "minimum": 1},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "observation_ids", "summary", "benchmark_validity", "attribution", "source_recoverability", "consolidated_root_event", "process_cause", "evidence_locators", "trajectory_locators", "learning_eligible", "recommended_action"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^F[0-9]{3}$"},
          "observation_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^err_[0-9]{4,}$"}},
          "summary": {"type": "string", "minLength": 1},
          "benchmark_validity": {"enum": ["valid", "invalid", "uncertain"]},
          "attribution": {"enum": ["agent", "evaluator", "ground_truth", "policy", "ambiguous"]},
          "source_recoverability": {"enum": ["recoverable", "not_recoverable", "uncertain"]},
          "consolidated_root_event": {"type": "boolean"},
          "process_cause": {"enum": ["evidence_not_retrieved", "extraction_failure", "evidence_misinterpreted", "molecular_reasoning", "graph_abstraction", "output_bookkeeping", "benchmark_or_policy", "not_applicable"]},
          "evidence_locators": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "trajectory_locators": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "learning_eligible": {"type": "boolean"},
          "recommended_action": {"enum": ["none", "knowledge_card_only", "prompt_rule", "deterministic_checker", "prompt_and_checker"]}
        }
      }
    },
    "pact_proposal": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "category", "trigger", "instruction", "recommended_checker", "supporting_finding_ids", "protocol_neutral"],
          "properties": {
            "title": {"type": "string", "minLength": 1, "maxLength": 120},
            "category": {"enum": ["evidence", "oligo", "state", "transition", "topology", "linkage", "bookkeeping"]},
            "trigger": {"type": "string", "minLength": 1, "maxLength": 500},
            "instruction": {"type": "string", "minLength": 1, "maxLength": 1200},
            "recommended_checker": {"enum": ["none", "physical_oligo_linkage", "product_conservation", "source_reconciliation", "state_event_projection", "strand_pairing", "terminal_reachability", "typed_edges"]},
            "supporting_finding_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^F[0-9]{3}$"}},
            "protocol_neutral": {"type": "boolean", "const": true}
          }
        }
      ]
    },
    "review_summary": {"type": "string", "minLength": 1}
  }
}

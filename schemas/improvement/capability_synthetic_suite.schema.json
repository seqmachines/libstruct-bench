{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/capability_synthetic_suite.schema.json",
  "title": "Declarative LibGen capability synthetic suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_capability_synthetic_suite.v1"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "polarity", "covers", "argv", "expected"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "polarity": {"enum": ["positive", "negative", "boundary"]},
        "covers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "argv": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit_code", "status", "finding_codes"],
          "properties": {
            "exit_code": {"type": "integer", "enum": [0, 1, 2]},
            "status": {"enum": ["pass", "findings", "error"]},
            "finding_codes": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}

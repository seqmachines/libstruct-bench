__pycache__/
.venv/
.DS_Store
# Local agent state is ignored except for the reviewed project audit skill.
.agents/*
!.agents/skills/
.agents/skills/*
!.agents/skills/libstruct-audit/
!.agents/skills/libstruct-audit/**
.claude/settings.local.json
tmp/
analysis/*

# Harbor run outputs
jobs/
runs/
scripts/

# Local secrets and credentials
.env
.env.*
!.env.example
*.token
auth.json

# Python caches and test artifacts
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Logs and temporary files
*.log
*.tmp

# Keep private benchmark answers out of GitHub.
groundtruth/
!schemas/groundtruth/
!schemas/groundtruth/*.schema.json
ground_truth/
**/groundtruth_oligos.json
**/ground_truth_oligos.json

# Frozen Libgen copies are intentionally tracked only in Harbor's private
# verifier build context. The agent image is built from the sibling
# `environment/` directory and cannot access these files.
!benchmarks/libgen/tasks/*/tests/groundtruth/
!benchmarks/libgen/tasks/*/tests/groundtruth/*.json

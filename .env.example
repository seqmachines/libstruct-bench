# Copy to .env and enter your OpenRouter API key locally.
# Load into your shell with: set -a; source .env; set +a
OPENROUTER_API_KEY=

# Claude Code CLI subscription login for Harbor containers.
# Run `claude setup-token`, then paste its printed token here in your local .env.
CLAUDE_CODE_OAUTH_TOKEN=

# Host-side experiment archive. Use a separate ignored .env.archive.local for
# real credentials. ./tools/libstruct-archive loads that profile when invoked.
# Native runner hooks are off until set to local or r2.
LSB_ARCHIVE_MODE=off
# Paths default to the repository in the current directory, its runs/ folder,
# sibling protocols-test and important_runs, and a private state directory.
# LSB_REPO_ROOT=/absolute/path/to/libstruct-bench
# LSB_RUNS_ROOT=/absolute/path/to/libstruct-bench/runs
# LIBSTRUCT_DATA_ROOT=/absolute/path/to/protocols-test
# LSB_IMPORTANT_RUNS=/absolute/path/to/important_runs
# LSB_ARCHIVE_STATE=/absolute/private/path/to/archive-state

R2_ENDPOINT_URL=
R2_EVIDENCE_BUCKET=
R2_ARCHIVE_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MONGODB_URI=
LSB_MONGO_DATABASE=proofread
# Set manually after checking the output of libstruct-archive target.
# An empty confirmation keeps automatic production writes disabled.
LSB_CONFIRMED_TARGET=

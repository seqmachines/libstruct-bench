{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "libstruct.archive.trial.v1"
    },
    "experiment_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "trial_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protocol_id": {
      "type": "string"
    },
    "technology_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "job_path": {
      "type": "string"
    },
    "execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "executor": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "model_version",
        "harness_version",
        "git_commit",
        "reasoning",
        "seed",
        "usage",
        "metrics",
        "duration_seconds"
      ]
    },
    "source_bundle_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_bundle": {
      "type": "object",
      "required": [
        "protocol_id",
        "status",
        "documents"
      ],
      "properties": {
        "status": {
          "enum": [
            "unresolved",
            "verified",
            "candidate",
            "name-only",
            "name-only-candidate"
          ]
        },
        "documents": {
          "type": "array"
        }
      }
    },
    "source_manifest_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "checkpoints": {
      "type": "array"
    },
    "paper": {
      "type": "array"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "role": {
            "enum": [
              "configuration",
              "evaluation",
              "trajectory",
              "output",
              "log",
              "source",
              "checkpoint",
              "artifact"
            ]
          },
          "original_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "original_size": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "withheld",
              "original",
              "sanitized"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "role",
          "original_sha256",
          "original_size",
          "status"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "withheld"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "not": {
                "required": [
                  "key"
                ]
              }
            },
            "else": {
              "required": [
                "sha256",
                "size",
                "key"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "run_id",
    "trial_id",
    "protocol_id",
    "technology_id",
    "path",
    "job_path",
    "execution_id",
    "job_id",
    "model",
    "executor",
    "status",
    "metadata",
    "source_bundle_id",
    "source_bundle",
    "source_manifest_key",
    "checkpoints",
    "paper",
    "artifacts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

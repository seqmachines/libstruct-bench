{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/capability-pack/work_record.schema.json",
  "title": "Model-neutral LibGen capability work record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "source_coverage", "inventory", "claims", "state_signatures", "event_records", "drafts"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_capability_work_record.v1"},
    "protocol_id": {"type": "string", "minLength": 1},
    "source_coverage": {"type": "array", "minItems": 1},
    "inventory": {"type": "array", "minItems": 1},
    "claims": {"type": "array"},
    "state_signatures": {"type": "array"},
    "event_records": {"type": "array"},
    "drafts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t2", "t3"],
      "properties": {
        "t2": {"type": "object", "required": ["protocol_id", "oligos"]},
        "t3": {"type": "object", "required": ["protocol_id", "workflows"]}
      }
    }
  }
}

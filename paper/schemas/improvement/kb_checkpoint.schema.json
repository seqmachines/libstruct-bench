{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/kb_checkpoint.schema.json",
  "title": "Immutable KB checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design_digest", "label", "training_count", "microstate", "catalog", "pact", "validation_protocol_ids", "test_protocol_ids", "created_at", "checkpoint_digest"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_kb_checkpoint.v1"},
    "design_digest": {"$ref": "#/$defs/sha256"},
    "label": {"type": "string", "pattern": "^C[0-9]+$"},
    "training_count": {"type": "integer", "minimum": 0},
    "microstate": {"$ref": "#/$defs/artifact"},
    "catalog": {"$ref": "#/$defs/artifact"},
    "pact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "digest"],
      "properties": {
        "kind": {"enum": ["none", "learned"]},
        "digest": {"$ref": "#/$defs/sha256"},
        "path": {"type": "string"}
      }
    },
    "validation_protocol_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/protocol_id"}},
    "test_protocol_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/protocol_id"}},
    "created_at": {"type": "string", "format": "date-time"},
    "checkpoint_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/kb_run_receipt.schema.json",
  "title": "Resumable Harbor or local-Codex process receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_kind", "run_id", "status", "plan_path", "plan_sha256", "command", "pid", "started_at", "finished_at", "returncode", "stdout_path", "stderr_path", "result_root", "aggregate_path", "receipt_digest"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_kb_run_receipt.v1"},
    "run_kind": {"enum": ["c0", "training", "validation", "test", "adjudicator", "critic", "repair"]},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["running", "succeeded", "failed", "cancelled"]},
    "plan_path": {"type": "string", "minLength": 1},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "pid": {"type": ["integer", "null"], "minimum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "returncode": {"type": ["integer", "null"]},
    "stdout_path": {"type": "string", "minLength": 1},
    "stderr_path": {"type": "string", "minLength": 1},
    "result_root": {"type": "string", "minLength": 1},
    "aggregate_path": {"type": ["string", "null"]},
    "receipt_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}

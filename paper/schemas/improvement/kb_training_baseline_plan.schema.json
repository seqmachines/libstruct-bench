{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/kb_training_baseline_plan.schema.json",
  "title": "Immutable training comparison plan backed by a preserved Codex C0 trial",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "design_digest",
    "state_id",
    "training_ordinal",
    "protocol_id",
    "pact_digest",
    "baseline_registry_digest",
    "baseline_condition",
    "baseline_trial",
    "repair_policy",
    "created_at",
    "plan_digest"
  ],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_kb_training_baseline_plan.v1"},
    "design_digest": {"$ref": "#/$defs/sha256"},
    "state_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
    "training_ordinal": {"type": "integer", "minimum": 1},
    "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "pact_digest": {"$ref": "#/$defs/sha256"},
    "baseline_registry_digest": {"$ref": "#/$defs/sha256"},
    "baseline_condition": {
      "enum": ["raw_codex", "codex_c0_empty_memory_base_pack"]
    },
    "baseline_trial": {"$ref": "#/$defs/trial"},
    "repair_policy": {"const": "preserve_original_prediction_no_repair"},
    "created_at": {"type": "string", "format": "date-time"},
    "plan_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "trial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trial_root", "artifacts", "runtime_artifacts", "trial_digest"],
      "properties": {
        "trial_root": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "config",
            "result",
            "t2_prediction",
            "t3_prediction",
            "trajectory",
            "reward",
            "verifier_details",
            "error_analysis"
          ],
          "properties": {
            "config": {"$ref": "#/$defs/artifact"},
            "result": {"$ref": "#/$defs/artifact"},
            "t2_prediction": {"$ref": "#/$defs/artifact"},
            "t3_prediction": {"$ref": "#/$defs/artifact"},
            "trajectory": {"$ref": "#/$defs/artifact"},
            "reward": {"$ref": "#/$defs/artifact"},
            "verifier_details": {"$ref": "#/$defs/artifact"},
            "error_analysis": {"$ref": "#/$defs/artifact"}
          }
        },
        "runtime_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "path", "sha256"],
            "properties": {
              "label": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "trial_digest": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

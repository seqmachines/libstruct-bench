{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/kb_graph_card.schema.json",
  "title": "Pseudonymous source-tiered LibGen molecular graph card",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exemplar_id", "training_ordinal", "workflows", "card_digest"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_kb_graph_card.v1"},
    "exemplar_id": {"type": "string", "pattern": "^exm-[a-f0-9]{32}$"},
    "training_ordinal": {"type": "integer", "minimum": 1},
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workflow_id", "initial_state_ids", "final_outputs", "states", "transitions"],
        "properties": {
          "workflow_id": {"type": "string", "pattern": "^workflow-[0-9]{3}$"},
          "initial_state_ids": {"type": "array", "items": {"type": "string"}},
          "final_outputs": {"type": "array", "items": {"type": "object"}},
          "states": {"type": "array", "items": {"type": "object"}},
          "transitions": {"type": "array", "items": {"type": "object"}}
        }
      }
    },
    "card_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}

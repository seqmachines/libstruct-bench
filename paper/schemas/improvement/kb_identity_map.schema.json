{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seqmachines.org/schemas/libstruct/improvement/kb_identity_map.schema.json",
  "title": "Private protocol-to-exemplar identity map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "design_digest", "mapping_nonce", "entries", "identity_map_digest"],
  "properties": {
    "schema_version": {"const": "libstruct.libgen_kb_identity_map.v1"},
    "design_digest": {"$ref": "#/$defs/sha256"},
    "mapping_nonce": {"$ref": "#/$defs/sha256"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["protocol_id", "training_ordinal", "exemplar_id"],
        "properties": {
          "protocol_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
          "training_ordinal": {"type": "integer", "minimum": 1},
          "exemplar_id": {"type": "string", "pattern": "^exm-[a-f0-9]{32}$"}
        }
      }
    },
    "identity_map_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
